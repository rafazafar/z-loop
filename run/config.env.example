# config.env — copied to config.env (gitignored). Secrets and overrides.
# Sourced by run/common.sh on every invocation.

# client repo location (default shown)
#KOKOLOG_REPO=/Users/zafar/dev/kokolog-monitor

# 9router endpoint for opencode's openai-compatible provider.
# If your global ~/.config/opencode already defines the 9router provider,
# leave this unset — spawns fall back to your global config cleanly.
#OPENCODE_9ROUTER_BASEURL=https://your-9router-host/v1
