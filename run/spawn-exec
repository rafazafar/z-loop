#!/bin/bash
# spawn-exec — runs INSIDE the tmux session. Always produces a result file
# and a done sentinel, even on crash. The loop never waits on silence.
# usage: spawn-exec <id> <model> <variant> <workdir> <prompt-file>
set -u
id="$1"; model="$2"; variant="$3"; workdir="$4"; prompt_file="$5"
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

result="$SESSIONS/$id.result"
donef="$SESSIONS/$id.done"
exitf="$SESSIONS/$id.exit"
jsonlog="$LOGS/$id.jsonl"
exit_code=0

finish() {
  # result file must exist even if the agent never wrote one
  if [ ! -s "$result" ]; then
    printf 'NO RESULT WRITTEN. Exit status: %s. See %s\n' "$exit_code" "$jsonlog" > "$result"
  fi
  printf '%s\n' "$exit_code" > "$exitf.tmp" && mv "$exitf.tmp" "$exitf"
  touch "$donef"
}
trap 'finish' EXIT
trap 'exit_code=143; exit 143' HUP TERM
trap 'exit_code=130; exit 130' INT

cd "$workdir" 2>/dev/null || { printf 'workdir missing: %s\n' "$workdir" > "$result"; exit_code=1; exit 1; }

# providers (9router, openai, zai coding plan, ...) resolve from the user's
# GLOBAL opencode config — deliberately no OPENCODE_CONFIG override here.
readonly_output=""
extra_output=""
case "$id" in
  *-verify) readonly_output="$result" ;;
  *-rev-*)
    ticket="${id%%-rev-*}"; readonly_output="$VERDICTS/$ticket-verdict.md"
    extra_output="$result" ;;
esac
if [ -n "$readonly_output" ]; then
  mv_pattern="mv *${readonly_output}"
  quoted_mv_pattern="mv *\"${readonly_output}\""
  write_pattern="printf * > ${readonly_output}.tmp"
  quoted_write_pattern="printf * > \"${readonly_output}.tmp\""
  export OPENCODE_PERMISSION
  if [ -n "$extra_output" ]; then
    rmove_pattern="mv *${extra_output}"
    quoted_rmove_pattern="mv *\"${extra_output}\""
    rwrite_pattern="printf * > ${extra_output}.tmp"
    quoted_rwrite_pattern="printf * > \"${extra_output}.tmp\""
    OPENCODE_PERMISSION="$(jq -cn --arg move "$mv_pattern" --arg qmove "$quoted_mv_pattern" --arg write "$write_pattern" --arg qwrite "$quoted_write_pattern" --arg rmove "$rmove_pattern" --arg rqmove "$quoted_rmove_pattern" --arg rwrite "$rwrite_pattern" --arg rqwrite "$quoted_rwrite_pattern" '
      {edit:"deny",task:"deny",external_directory:"allow",
       bash:{"*":"deny",($write):"allow",($qwrite):"allow",($move):"allow",($qmove):"allow",
             ($rwrite):"allow",($rqwrite):"allow",($rmove):"allow",($rqmove):"allow"}}')"
  else
    OPENCODE_PERMISSION="$(jq -cn --arg move "$mv_pattern" --arg qmove "$quoted_mv_pattern" --arg write "$write_pattern" --arg qwrite "$quoted_write_pattern" '
      {edit:"deny",task:"deny",external_directory:"allow",
       bash:{"*":"deny",($write):"allow",($qwrite):"allow",($move):"allow",($qmove):"allow"}}')"
  fi
else
  case "$id" in
    *-impl-*|loop-spec-sync-*)
      export OPENCODE_PERMISSION
      OPENCODE_PERMISSION='{"edit":"allow","task":"deny","external_directory":"allow"}'
      ;;
    loop-ticket-factory-*|loop-gardener-*|loop-decision-desk-*)
      stage_root="$STATE/staging/$id/**"
      mv_pattern="mv *${result}"
      quoted_mv_pattern="mv *\"${result}\""
      result_write_pattern="printf * > ${result}.tmp"
      quoted_result_write_pattern="printf * > \"${result}.tmp\""
      stage_write_pattern="printf * > $STATE/staging/$id/*"
      quoted_stage_write_pattern="printf * > \"$STATE/staging/$id/*\""
      export OPENCODE_PERMISSION
      OPENCODE_PERMISSION="$(jq -cn --arg move "$mv_pattern" --arg qmove "$quoted_mv_pattern" --arg resultWrite "$result_write_pattern" --arg qresultWrite "$quoted_result_write_pattern" --arg stageWrite "$stage_write_pattern" --arg qstageWrite "$quoted_stage_write_pattern" '
        {edit:"deny",task:"deny",external_directory:"allow",
         bash:{"*":"deny","git diff*":"allow","git status*":"allow","git log*":"allow","git show*":"allow",
               "gh pr view*":"allow","gh pr list*":"allow","gh issue view*":"allow","gh issue list*":"allow",
               "shasum *":"allow",($resultWrite):"allow",($qresultWrite):"allow",
               ($stageWrite):"allow",($qstageWrite):"allow",($move):"allow",($qmove):"allow"}}')"
      ;;
  esac
fi

# one-line prompt discipline: task payload lives in the prompt file
opencode run \
  --model "$model" \
  --variant "$variant" \
  --format json \
  --title "$id" \
  "$(cat "$prompt_file")" 2>>"$LOGS/$id.stderr" | tee -a "$jsonlog"

exit_code="${PIPESTATUS[0]}"
exit "$exit_code"
