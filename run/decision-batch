#!/bin/bash
# decision-batch - avoid model work when the decision domain has nothing to do,
# then run one blocking decision-desk cycle.
set -euo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

cards="$( { grep -l '^status: *open' "$LOOP_ROOT"/decisions/*.card.md 2>/dev/null || true; } | wc -l | tr -d ' ')"
parked="$( { ls "$STATE"/*.parked 2>/dev/null || true; } | wc -l | tr -d ' ')"
echo "open cards: $cards; parked tickets: $parked"
if [ "$cards" = "0" ] && [ "$parked" = "0" ]; then
  echo "nothing to decide; no queue this batch"
  timeline decision-desk "batch | nothing to decide"
  exit 0
fi

exec "$LOOP_ROOT/run/domain-loop" decision-desk
