<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.kokolog.loop.dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>__LOOP_ROOT__/run/dashboard --no-open</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__LOOP_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__LAUNCH_PATH__</string>
        <key>KOKOLOG_DASHBOARD_PORT</key>
        <string>4177</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__LOOP_ROOT__/logs/launchd-dashboard.out</string>
    <key>StandardErrorPath</key>
    <string>__LOOP_ROOT__/logs/launchd-dashboard.err</string>
</dict>
</plist>
