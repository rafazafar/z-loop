<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.kokolog.loop.decisions</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>__LOOP_ROOT__/run/decision-batch</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__LOOP_ROOT__</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>9</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>17</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>
    <key>StandardOutPath</key>
    <string>__LOOP_ROOT__/logs/launchd-decisions.out</string>
    <key>StandardErrorPath</key>
    <string>__LOOP_ROOT__/logs/launchd-decisions.err</string>
</dict>
</plist>
