<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.kokolog.loop.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>__LOOP_ROOT__/run/sync-repository</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__LOOP_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__LAUNCH_PATH__</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__LOOP_ROOT__/logs/launchd-sync.out</string>
    <key>StandardErrorPath</key>
    <string>__LOOP_ROOT__/logs/launchd-sync.err</string>
</dict>
</plist>
