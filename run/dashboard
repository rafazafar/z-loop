#!/bin/bash
# dashboard — start the local Bench control plane.
set -euo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
port="${KOKOLOG_DASHBOARD_PORT:-4177}"
if [ "${1:-}" != "--no-open" ]; then
  (sleep 0.6; open "http://127.0.0.1:$port") &
fi
exec node "$LOOP_ROOT/web/server.mjs" --port "$port"
