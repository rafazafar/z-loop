#!/bin/bash
# resolve-ticket — retry an operational failure or record a genuine human disposition.
set -euo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || {
  echo "usage: resolve-ticket <ticket> <retry|resume|manual> [note]" >&2
  exit 64
}
ticket="$1"; mode="$2"; note="${3:-}"
case "$ticket" in ''|*[!0-9]*) echo "invalid ticket" >&2; exit 64 ;; esac
case "$mode" in retry|resume|manual) ;; *) echo "invalid disposition" >&2; exit 64 ;; esac
if [ "$mode" != retry ]; then
  [ "${#note}" -ge 12 ] || { echo "add a specific note of at least 12 characters" >&2; exit 64; }
  [ "${#note}" -le 4000 ] || { echo "note is too long" >&2; exit 64; }
fi

acquire_lock || { echo "another loop action is running" >&2; exit 75; }
trap release_lock EXIT

review="$STATE/$ticket.review.json"
runtime="$STATE/$ticket.runtime.json"
recorded_at="$(date -u +%FT%TZ)"

if [ "$mode" = retry ]; then
  [ -s "$runtime" ] || { echo "ticket #$ticket has no operational failure to retry" >&2; exit 65; }
  case "$(jq -r '.status // empty' "$runtime")" in
    needs-retry|retry-ready) ;;
    running) echo "ticket #$ticket already has a clean retry running" >&2; exit 65 ;;
    *) echo "ticket #$ticket does not have a retryable operational failure" >&2; exit 65 ;;
  esac
  jq --arg at "$recorded_at" '.status="retry-ready" | .owner_authorized=true | .updated_at=$at' \
    "$runtime" > "$runtime.tmp" && mv "$runtime.tmp" "$runtime"
  phase="$(jq -r '.phase // "in-progress"' "$runtime")"
  case "$phase" in in-progress|review|fix) ;; *) phase=in-progress ;; esac
  if [ -e "$STATE/$ticket.parked" ] || [ -e "$STATE/$ticket.runtime-failed" ]; then
    st_set "$ticket" "$phase"
  fi
  metric implement runs.jsonl "\"event\":\"owner-clean-retry\",\"ticket\":$ticket"
  timeline implement "ticket $ticket | owner authorized a clean retry from GitHub state"
  printf 'Ticket #%s clean retry queued from authoritative GitHub state\n' "$ticket"
  exit 0
fi

[ -f "$STATE/$ticket.parked" ] || { echo "ticket #$ticket is not awaiting a human decision" >&2; exit 65; }
[ -s "$review" ] || { echo "ticket #$ticket has no review record" >&2; exit 65; }

repo="$(ghrepo)"
pr="$(jq -r '.pr // empty' "$review")"
[ -n "$pr" ] || { echo "ticket #$ticket has no recorded PR" >&2; exit 65; }
meta="$(gh pr view "$pr" -R "$repo" --json state,baseRefOid,headRefOid)"
pr_state="$(printf '%s' "$meta" | jq -r .state)"
live_base="$(printf '%s' "$meta" | jq -r .baseRefOid)"
live_head="$(printf '%s' "$meta" | jq -r .headRefOid)"
old_head="$(jq -r '.head_oid // empty' "$review")"
old_reason="$(cat "$STATE/$ticket.parked")"
record="$STATE/$ticket.manual-intervention.json"
temporary="$record.tmp.$$"

if [ "$mode" = resume ]; then
  [ "$pr_state" = OPEN ] || { echo "PR must be open to resume assurance" >&2; exit 65; }
  [ "$live_head" != "$old_head" ] || { echo "push a new PR revision before assurance resumes" >&2; exit 65; }
  jq -n --argjson schema 1 --argjson ticket "$ticket" --arg pr "$pr" \
    --arg old_head "$old_head" --arg current_head "$live_head" --arg reason "$old_reason" \
    --arg note "$note" --arg at "$recorded_at" \
    '{schema:$schema,ticket:$ticket,pr:$pr,disposition:"resume-automated-assurance",previous_reviewed_head:$old_head,current_head:$current_head,parked_reason:$reason,note:$note,recorded_by:"owner (operator console)",recorded_at:$at}' \
    > "$temporary"
  mv "$temporary" "$record"
  jq --arg record "$(basename "$record")" '
    .action="review" | .base_oid="" | .head_oid="" | .source_session="" |
    .session_id="" | .profile="" | .remaining=[] | .completed=[] |
    .manual_intervention=$record' "$review" > "$review.tmp" && mv "$review.tmp" "$review"
  st_set "$ticket" review
  metric implement runs.jsonl "\"event\":\"manual-resume\",\"ticket\":$ticket,\"old_head\":\"${old_head:0:12}\",\"head\":\"${live_head:0:12}\""
  timeline implement "ticket $ticket | owner intervention recorded; assurance resumes on ${live_head:0:12}"
  printf 'Ticket #%s will resume assurance on %s\n' "$ticket" "${live_head:0:12}"
else
  jq -n --argjson schema 1 --argjson ticket "$ticket" --arg pr "$pr" --arg state "$pr_state" \
    --arg previous_head "$old_head" --arg current_head "$live_head" --arg reason "$old_reason" \
    --arg note "$note" --arg at "$recorded_at" \
    '{schema:$schema,ticket:$ticket,pr:$pr,pr_state:$state,disposition:"owner-managed",previous_reviewed_head:$previous_head,current_head:$current_head,parked_reason:$reason,note:$note,recorded_by:"owner (operator console)",recorded_at:$at}' \
    > "$temporary"
  mv "$temporary" "$record"
  jq --arg head "$live_head" --arg base "$live_base" --arg record "$(basename "$record")" \
    '.action="manual-takeover" | .head_oid=$head | .base_oid=$base | .manual_intervention=$record' \
    "$review" > "$review.tmp" && mv "$review.tmp" "$review"
  st_set "$ticket" manual-takeover
  metric implement runs.jsonl "\"event\":\"manual-takeover\",\"ticket\":$ticket,\"head\":\"${live_head:0:12}\""
  timeline implement "ticket $ticket | owner-managed at ${live_head:0:12}: $note"
  printf 'Ticket #%s is now owner-managed\n' "$ticket"
fi
