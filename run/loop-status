#!/bin/bash
set -uo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

snapshot="$(node "$LOOP_ROOT/web/status.mjs")" || {
  echo "loop status unavailable" >&2
  exit 1
}

echo "== kokolog-loop $(date '+%F %T') =="

echo; echo "-- attention --"
printf '%s' "$snapshot" | jq -r '
  if (.attention | length) == 0 then "  (none)"
  else .attention[] | "  [\(.severity)] \(.title)\n     \(.detail // "")\n     next: \(.action)"
  end'

echo; echo "-- domains --"
printf '%s' "$snapshot" | jq -r '.loops[] |
  "\(.id)\t\(.status)\t\(if .timerConfigured then (if .timerLoaded then "armed" else "not-armed" end) else "manual" end)\t\(.goal)\n   last: \(.lastEvent)"' \
  | while IFS=$'\t' read -r domain status timer rest; do
      if [ -n "${rest:-}" ]; then
        printf '%-15s %-8s %-10s %s\n' "$domain" "$status" "$timer" "$rest"
      else
        printf '%s\n' "$domain"
      fi
    done

echo; echo "-- current sessions --"
printf '%s' "$snapshot" | jq -r '
  if (.currentSessions | length) == 0 then "  (none)"
  else .currentSessions[] | "  \(.id) — \(.status) — last \(.lastActivity // "unknown")"
  end'

echo; echo "-- tickets and assurance --"
printf '%s' "$snapshot" | jq -r '
  def profile_marks:
    if (.assurance.total // 0) == 0 then "n/a"
    else [.assurance.profiles[] | "\(.name):\(if .status == "passed" then "pass" elif .status == "current" then "next" else "wait" end)"] | join(" ")
    end;
  if (.tickets | length) == 0 then "  (none)"
  else .tickets[] |
    "  #\(.id) \(.status) · PR \(if .prNumber then "#\(.prNumber) \(.prState)" else "none" end) · assurance \(.assurance.passed)/\(.assurance.total) · revision \(.round) · P0/P1 repair \(.repair)/\(.repairLimit)\n     \(profile_marks)\n     head: \(.headShort // "-") · last: \(.lastActivity // "unknown") · model-session duration: \(if .session then "\(.session.durationSeconds // 0)s" else "n/a" end)\n     next: \(.nextAction)\(if (.reason // "") != "" then "\n     reason: \(.reason)" else "" end)"
  end'

echo; echo "-- issue queue --"
printf '%s' "$snapshot" | jq -r '
  if .frontier.available then
    "  \(.frontier.eligible) ready now · \(.frontier.deferred) waiting · \(.frontier.labeled) in queue\n  next: \(if .frontier.next then "#\(.frontier.next.number) \(.frontier.next.title)" else "none" end)"
  else "  unavailable"
  end'

echo; echo "-- open decision cards --"
printf '%s' "$snapshot" | jq -r '
  if (.cards | map(select(.status == "open")) | length) == 0 then "  (none)"
  else .cards[] | select(.status == "open") | "  \(.name) — \(.title)"
  end'
