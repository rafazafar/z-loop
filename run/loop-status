#!/bin/bash
# loop-status — what the machine is doing right now. Pure bash rendering of
# state files. Collectors write data; nobody pays a model to fetch numbers.
set -uo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

echo "== kokolog-loop $(date '+%F %T') =="

echo; echo "-- domains --"
for d in implement spec-sync ticket-factory gardener decision-desk; do
  f="$LOOP_ROOT/domains/$d/README.md"
  [ -f "$f" ] || continue
  status="$(grep -m1 '^status:' "$f" | sed 's/status: *//')"
  goal="$(grep -m1 '^goal:' "$f" | sed 's/goal: *//')"
  last="$(grep -A1 '^## Timeline' "$f" | tail -1)"
  printf '%-15s %-8s %s\n' "$d" "${status:-?}" "${goal:-}"
  [ -n "${last:-}" ] && printf '   last: %s\n' "$last"
done

echo; echo "-- sessions --"
alive="$(tmux list-sessions 2>/dev/null | grep "^$tmux_session_prefix-" || true)"
if [ -n "$alive" ]; then printf '%s\n' "$alive"; else echo "(none in flight)"; fi
undone=""
for d in "$SESSIONS"/*.done; do
  [ -e "$d" ] || continue
  r="${d%.done}.result"
  [ -e "${d%.done}.harvested" ] || { undone="$undone $(basename "${d%.done}")"; }
done
[ -n "$undone" ] && echo "awaiting harvest:$undone"

echo; echo "-- tickets --"
for f in "$STATE"/[0-9]*.*; do
  [ -e "$f" ] || continue
  b="$(basename "$f")"
  case "$b" in
    *.merged-unverified)
      reason="$(cat "$f" 2>/dev/null || true)"
      printf '%s — %s\n' "$b" "${reason:-PR merged before assurance completed}" ;;
    *.in-progress|*.review|*.fix|*.done|*.parked|*.blocked-decision|*.ready)
      printf '%s\n' "$b" ;;
  esac
done | sort | uniq | sed 's/^/  /' || true
count="$(ls "$STATE"/[0-9]*.* 2>/dev/null | wc -l | tr -d ' ')"
[ "$count" = "0" ] && echo "  (no ticket state — frontier untouched)"

echo; echo "-- open decision cards --"
ls "$LOOP_ROOT"/decisions/*.card.md >/dev/null 2>&1 \
  && grep -l '^status: *open' "$LOOP_ROOT"/decisions/*.card.md | sed 's/^/  /' \
  || echo "  (none)"

echo; echo "-- LOG tail --"
tail -n 14 "$LOGMD" 2>/dev/null | sed 's/^/  /'
