#!/bin/bash
# spec-sync-trigger — standalone transcript poller (same logic as the tick's
# spec-sync branch, kept separate for its own launchd interval).
set -uo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

domain_active spec-sync || { echo "spec-sync paused"; exit 0; }
command -v opencode >/dev/null 2>&1 || exit 0

seen="$STATE/specsync.seen"
mkdir -p "$STATE"
ls "$KOKOLOG_REPO/docs/meeting-transcripts" 2>/dev/null | grep -v '^README' | sort > "$STATE/specsync.ls"

[ -f "$seen" ] || { cp "$STATE/specsync.ls" "$seen"; echo "baseline recorded"; exit 0; }
diff -q "$seen" "$STATE/specsync.ls" >/dev/null 2>&1 && { echo "no new transcripts"; exit 0; }

newfile="$(comm -13 "$seen" "$STATE/specsync.ls" 2>/dev/null | head -1)"
[ -z "$newfile" ] && { cp "$STATE/specsync.ls" "$seen"; exit 0; }
tmux list-sessions 2>/dev/null | grep -q "^${tmux_session_prefix}-dist-" && { echo "distiller busy"; exit 0; }

sid="dist-$(date +%s)"
pf="$SESSIONS/$sid.prompt"
{
  printf 'You are the Distiller. Read ~/.kokolog-loop/agents/distiller.md and obey it fully.\n'
  printf 'New transcript: %s in docs/meeting-transcripts of %s.\n' "$newfile" "$KOKOLOG_REPO"
  printf 'Doc-only branch. Result: %s.result, sentinel: %s.done (state/sessions/).\n' "$SESSIONS/$sid" "$SESSIONS/$sid"
} > "$pf"
if "$LOOP_ROOT/run/spawn" start "$sid" "$(route_model distiller)" "$KOKOLOG_REPO" "$pf"; then
  timeline spec-sync "transcript detected: $newfile -> distiller spawned"
  cp "$STATE/specsync.ls" "$seen"   # mark seen ONLY on successful spawn; failure retries next poll
  echo "distiller spawned for $newfile"
else
  echo "distiller spawn failed; will retry next poll"
fi
