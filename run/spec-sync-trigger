#!/bin/bash
# spec-sync-trigger - reconcile transcript hashes and run one claimed item.
set -uo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

domain_active spec-sync || { echo "spec-sync paused"; exit 0; }
command -v opencode >/dev/null 2>&1 || exit 1

transcripts="$KOKOLOG_REPO/docs/meeting-transcripts"
[ -n "$KOKOLOG_REPO" ] && [ -d "$transcripts" ] || {
  echo "transcript directory unavailable" >&2
  exit 1
}

mkdir -p "$STATE/specsync-attempts"
snapshot="$STATE/specsync.snapshot"
snapshot_tmp="$snapshot.tmp"
ledger="$STATE/specsync.ledger"
ledger_tmp="$ledger.tmp"
: > "$snapshot_tmp"

for file in "$transcripts"/*; do
  [ -f "$file" ] || continue
  name="${file##*/}"
  [ "$name" = README.md ] && continue
  case "$name" in *$'\t'*|*$'\n'*) echo "unsupported transcript filename: $name" >&2; exit 1 ;; esac
  hash="$(shasum -a 256 "$file" | cut -d' ' -f1)" || exit 1
  printf '%s\t%s\n' "$hash" "$name" >> "$snapshot_tmp"
done
sort -o "$snapshot_tmp" "$snapshot_tmp"
mv "$snapshot_tmp" "$snapshot"

record_status() { # hash status filename
  local item_hash="$1" item_status="$2" item_name="$3"
  { grep -Fv "$item_hash"$'\t' "$ledger" 2>/dev/null || true; printf '%s\t%s\t%s\n' "$item_hash" "$item_status" "$item_name"; } \
    | sort > "$ledger_tmp" && mv "$ledger_tmp" "$ledger"
}

if [ ! -f "$ledger" ]; then
  : > "$ledger"
  old_seen="$STATE/specsync.seen"
  if [ -s "$old_seen" ]; then
    while IFS=$'\t' read -r hash name; do
      grep -Fxq "$name" "$old_seen" && record_status "$hash" baseline "$name"
    done < "$snapshot"
    echo "migrated transcript baseline"
  else
    while IFS=$'\t' read -r hash name; do
      record_status "$hash" baseline "$name"
    done < "$snapshot"
    echo "baseline recorded"
  fi
  exit 0
fi

selected_hash=""
selected_name=""
while IFS=$'\t' read -r hash name; do
  if ! grep -Fq "$hash"$'\t' "$ledger"; then
    selected_hash="$hash"
    selected_name="$name"
    break
  fi
done < "$snapshot"

[ -n "$selected_hash" ] || { echo "no new transcripts"; exit 0; }

attempt_file="$STATE/specsync-attempts/$selected_hash"
attempts="$(cat "$attempt_file" 2>/dev/null || echo 0)"
max_attempts="$(rule max_impl_attempts)"
if [ "$attempts" -ge "${max_attempts:-3}" ]; then
  record_status "$selected_hash" failed "$selected_name"
  timeline spec-sync "transcript $selected_name | blocked: attempts exhausted"
  echo "transcript blocked after $attempts attempts: $selected_name" >&2
  exit 1
fi

output=""
if output="$("$LOOP_ROOT/run/domain-loop" spec-sync "Transcript: $selected_name; SHA256: $selected_hash; operation: spec-sync:$selected_hash" 2>&1)"; then
  outcome="$(printf '%s\n' "$output" | grep -m1 '^OUTCOME:' | cut -d' ' -f2)"
  case "$outcome" in
    PASS|NOOP)
      record_status "$selected_hash" completed "$selected_name"
      rm -f "$attempt_file"
      printf '%s\n' "$output"
      ;;
    BLOCKED)
      record_status "$selected_hash" blocked "$selected_name"
      rm -f "$attempt_file"
      printf '%s\n' "$output"
      ;;
    *)
      echo "domain cycle returned no valid outcome" >&2
      exit 1
      ;;
  esac
else
  code=$?
  if [ "$code" = 75 ]; then
    printf '%s\n' "$output"
    exit 0
  fi
  attempts=$((attempts + 1))
  printf '%s\n' "$attempts" > "$attempt_file"
  printf '%s\n' "$output" >&2
  echo "spec-sync attempt $attempts failed; item remains pending" >&2
  exit 1
fi
