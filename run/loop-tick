#!/bin/bash
# loop-tick — the heartbeat. One idempotent pass:
#   reap timed-out sessions -> harvest finished sessions -> advance tickets
#   work the ready-ticket frontier (spawn implementer, single-flight)
# A tick is a gate, not a heartbeat that always works. Never alarms.
# Transcript polling lives in run/spec-sync-trigger (own timer), not here.
set -uo pipefail   # NOT -e: one failed branch must not kill the pass
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

for arg in "$@"; do
  case "$arg" in
    --once) ;;  # one pass is the only mode; flag kept for launchd/readability
    *) echo "usage: loop-tick [--once]" >&2; exit 64 ;;
  esac
done

acquire_lock || { echo "another tick holds the lock; exiting"; exit 0; }
trap release_lock EXIT

say() { printf '[%s] %s\n' "$(date +%T)" "$*"; }

# ---------- preflight (soft) ------------------------------------------------
have_bin() { command -v "$1" >/dev/null 2>&1; }
if ! have_bin opencode || ! have_bin gh || ! have_bin jq || ! have_bin tmux; then
  timeline implement "tick | skipped: missing binary (run run/doctor)"
  exit 0
fi
GH_REPO="$(ghrepo)" || { say "cannot resolve gh repo"; exit 0; }
LABEL="$(jqget .github.frontier_label)"

# ---------- reap stray clones ------------------------------------------------
reap_days="$(rule clone_reap_days)"
find "$CLONES" -maxdepth 1 -type d -name '[0-9]*' -mtime "+${reap_days:-7}" -exec rm -rf {} + 2>/dev/null || true

# ---------- reap timed-out sessions -------------------------------------------
timeout_sec="$(rule session_timeout_sec)"
for sess in $(tmux list-sessions -F '#S' 2>/dev/null | grep "^${tmux_session_prefix}-" | sed "s/^${tmux_session_prefix}-//"); do
  [ -f "$SESSIONS/$sess.done" ] && continue
  pf="$SESSIONS/$sess.prompt"
  [ -f "$pf" ] || continue
  age=$(( $(date +%s) - $(stat -f %m "$pf") ))
  if [ "$age" -gt "${timeout_sec:-3600}" ]; then
    tmux kill-session -t "${tmux_session_prefix}-${sess}" 2>/dev/null
    [ -s "$SESSIONS/$sess.result" ] || printf 'TIMEOUT: reaped after %ss by tick\n' "$age" > "$SESSIONS/$sess.result"
    touch "$SESSIONS/$sess.done"
    case "$sess" in
      dist-*)  timeline spec-sync "session $sess | reaped: timeout ${age}s" ;;
      desk-*)  timeline decision-desk "session $sess | reaped: timeout ${age}s" ;;
      *)       timeline implement "session $sess | reaped: timeout ${age}s" ;;
    esac
  fi
done

# ---------- harvest finished sessions ----------------------------------------
# session ids: <ticket>-impl-aN   |   <ticket>-rev-rN   |   dist-<epoch>
harvest_impl() { # ticket
  local n="$1" res
  # newest impl result for this ticket
  res="$(ls -t "$SESSIONS/$n-impl"-a*.result 2>/dev/null | head -1)"
  [ -n "${res:-}" ] && [ -s "$res" ] || res="/dev/null"
  if grep -q 'DECOMPOSE' "$res" 2>/dev/null; then
    st_set "$n" parked
    timeline implement "ticket $n | parked: needs decomposition"
    return
  fi
  local pr
  pr="$(grep -o 'https://github.com/[^ )]*/pull/[0-9]*' "$res" 2>/dev/null | head -1)"
  if [ -z "$pr" ]; then
    st_set "$n" parked
    timeline implement "ticket $n | parked: no PR in result"
    return
  fi
  st_set "$n" review
  printf '%s\n' "$pr" > "$STATE/$n.pr"
  spawn_review "$n" "$pr"
}

spawn_review() { # ticket pr
  local n="$1" pr="$2"
  local round=1
  [ -f "$STATE/$n.round" ] && round=$(( $(cat "$STATE/$n.round") + 1 ))
  printf '%s\n' "$round" > "$STATE/$n.round"
  local pf="$SESSIONS/$n-rev-r${round}.prompt"
  {
    printf 'You are the Reviewer. Read ~/.kokolog-loop/agents/reviewer.md and obey it fully.\n'
    printf 'Issue: %s  PR: %s  Round: %s\n' "$n" "$pr" "$round"
    printf 'Clone for inspection: %s\n' "$(ls -d "$CLONES/$n"-* 2>/dev/null | tail -1)"
    printf 'Write your verdict to ~/.kokolog-loop/verdicts/%s-verdict.md (strict grammar).\n' "$n"
  } > "$pf"
  if "$LOOP_ROOT/run/spawn" start "$n-rev-r${round}" "$(route_model reviewer)" \
    "$(route_variant reviewer)" "$KOKOLOG_REPO" "$pf" >/dev/null; then
    timeline implement "ticket $n | review round $round spawned"
  else
    st_set "$n" parked
    timeline implement "ticket $n | parked: review spawn failed (round $round)"
    log_append "ticket $n parked" implement "Reviewer spawn failed; needs human attention." "state/$n.parked"
  fi
}

harvest_review() { # ticket
  local n="$1"
  local round; round="$(cat "$STATE/$n.round" 2>/dev/null || echo 1)"
  local v="$VERDICTS/$n-verdict.md"
  [ -f "$v" ] || { st_set "$n" parked; timeline implement "ticket $n | parked: no verdict file"; return; }
  local verdict task
  verdict="$(grep -m1 '^VERDICT:' "$v" | cut -d' ' -f2)"
  task="$(grep -m1 '^TASK:' "$v" | cut -d' ' -f2)"
  metric implement runs.jsonl "\"event\":\"verdict\",\"ticket\":$n,\"verdict\":\"${verdict:-?}\",\"task\":\"${task:-?}\",\"round\":$round"
  if [ "$verdict" = "PASS" ]; then
    st_set "$n" done
    timeline implement "ticket $n | PASS round $round — PR awaits human merge"
    log_append "ticket $n verified" implement "PASS at review round $round; PR ready for merge." "$v"
  else
    local maxr; maxr="$(rule max_verify_rounds)"
    if [ "${round:-0}" -lt "${maxr:-3}" ]; then
      # findings go back to a FRESH implementer session
      st_set "$n" fix
      local attempt; attempt=$(( $(ls "$SESSIONS/$n-impl"-a*.result 2>/dev/null | wc -l | tr -d ' ') + 1 ))
      local maxa; maxa="$(rule max_impl_attempts)"
      if [ "$attempt" -gt "${maxa:-3}" ]; then
        st_set "$n" parked
        timeline implement "ticket $n | parked: impl attempts exhausted ($maxa)"
        log_append "ticket $n parked" implement "Implementation attempts exhausted." "$v"
        return
      fi
      # tier-up policy from routing.json: past N failures, escalate model
      local model variant after from_alias to_alias from
      model="$(route_model implementer)"
      variant="$(route_variant implementer)"
      after="$(jq -r '.rules.retry_tier_up.after_failures // 2' "$ROUTING")"
      from_alias="$(jq -r '.rules.retry_tier_up.from' "$ROUTING")"
      to_alias="$(jq -r '.rules.retry_tier_up.to' "$ROUTING")"
      from="$(alias_model "$from_alias")"
      if [ $((attempt - 1)) -ge "${after:-2}" ] && [ "$model" = "$from" ]; then
        model="$(alias_model "$to_alias")"
        variant="$(alias_variant "$to_alias")"
      fi
      local pf="$SESSIONS/$n-impl-a${attempt}.prompt"
      {
        printf 'You are the Implementer. Read ~/.kokolog-loop/agents/implementer.md and obey it fully.\n'
        printf 'Issue: %s  This is attempt %s after review FAIL findings below.\n' "$n" "$attempt"
        printf 'Existing clone+branch: %s\n' "$(ls -d "$CLONES/$n"-* 2>/dev/null | tail -1)"
        printf 'Fix ONLY the findings. Do not expand scope. Same diff budget.\n\n'
        sed -n '/^findings:/,$p' "$v"
      } > "$pf"
      if "$LOOP_ROOT/run/spawn" start "$n-impl-a${attempt}" "$model" "$variant" \
        "$KOKOLOG_REPO" "$pf" >/dev/null; then
        timeline implement "ticket $n | FAIL r$round -> fix attempt $attempt spawned"
      else
        st_set "$n" parked
        timeline implement "ticket $n | parked: fix spawn failed (attempt $attempt)"
        log_append "ticket $n parked" implement "Fix spawn failed; needs human attention." "state/$n.parked"
      fi
    else
      st_set "$n" parked
      timeline implement "ticket $n | parked: $maxr rounds exhausted"
      log_append "ticket $n parked" implement "Review rounds exhausted." "$v"
    fi
  fi
}

for donef in "$SESSIONS"/*.done; do
  [ -e "$donef" ] || continue
  local_id="${donef%.done}"; local_id="${local_id##*/}"
  harvested="${donef%.done}.harvested"
  [ -e "$harvested" ] && continue
  touch "$harvested"  # before dispatch: a crash loses one transition, never duplicates it
  case "$local_id" in
    *-impl-*) n="${local_id%%-impl-*}"; harvest_impl "$n" ;;
    *-rev-*)  n="${local_id%%-rev-*}";  harvest_review "$n" ;;
    dist-*)   timeline spec-sync "distiller session finished: $local_id" ;;
    desk-*)   timeline decision-desk "decision-batch session finished: $local_id" ;;
  esac
done

# ---------- frontier (implement domain) --------------------------------------
frontier() {
  domain_active implement || { say "implement paused"; return 0; }
  # single-flight: at most one impl session alive
  if tmux list-sessions 2>/dev/null | grep -q "^${tmux_session_prefix}-[0-9]*-impl-"; then
    say "impl in flight; frontier idle this tick"; return 0
  fi
  local issues
  issues="$(gh issue list -R "$GH_REPO" --label "$LABEL" --state open --limit 30 \
            --json number,title --jq '.[] | "\(.number)\t\(.title)"' 2>/dev/null)" || return 0
  [ -n "$issues" ] || { say "frontier empty"; return 0; }
  while IFS=$'\t' read -r n title; do
    st_exists "$n" && continue
    # blockers: parse "Blocked by" refs from body; all must be closed
    body="$(gh issue view "$n" -R "$GH_REPO" --json body -q .body 2>/dev/null || true)"
    blocked=0
    for b in $(printf '%s' "$body" | sed -n '/[Bb]locked by/,/^[A-Z*#]/p' | grep -o '#[0-9]\+' | tr -d '#'); do
      s="$(gh issue view "$b" -R "$GH_REPO" --json state -q .state 2>/dev/null || echo open)"
      [ "$s" = "closed" ] || { blocked=1; break; }
    done
    [ "$blocked" = 1 ] && continue
    # spawn implementer in a fresh clone
    clone="$CLONES/$n-a1"
    git clone -q "$KOKOLOG_REPO" "$clone" 2>/dev/null || continue
    branch="loop/$n-$(date +%s)"
    git -C "$clone" checkout -q -b "$branch"
    budget="$(jq -c .rules.diff_budget "$ROUTING")"
    pf="$SESSIONS/$n-impl-a1.prompt"
    {
      printf 'You are the Implementer. Read ~/.kokolog-loop/agents/implementer.md first and obey it fully.\n'
      printf 'Issue number: %s (%s) in repo %s.\n' "$n" "$title" "$(ghrepo)"
      printf 'Your clone: %s (branch %s already created; work ONLY here).\n' "$clone" "$branch"
      printf 'Diff budget (hard stop): %s\n' "$budget"
      printf 'When done: push, open ONE PR, then write %s and touch %s.\n' \
        "$SESSIONS/$n-impl-a1.result" "$SESSIONS/$n-impl-a1.done"
    } > "$pf"
    if "$LOOP_ROOT/run/spawn" start "$n-impl-a1" "$(route_model implementer)" \
      "$(route_variant implementer)" "$clone" "$pf" >/dev/null; then
      st_set "$n" in-progress
      timeline implement "ticket $n | implementer spawned (frontier)"
      say "spawned implementer for #$n: $title"
    else
      rm -rf "$clone"
      timeline implement "ticket $n | frontier spawn failed; retry next tick"
    fi
    return 0   # one per tick; single-flight
  done <<<"$issues"
}
frontier

metric implement runs.jsonl "\"event\":\"tick\""
timeline implement "tick | pass complete"
say "tick complete"
