#!/bin/bash
set -uo pipefail   # NOT -e: one failed branch must not kill the pass
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

mode=dispatch
for arg in "$@"; do
  case "$arg" in
    --once|--dispatch) mode=dispatch ;;
    --collect-only) mode=collect ;;
    --advance-current|--reconcile-only) mode=advance ;;
    --start-next) mode=frontier ;;
    *) echo "usage: loop-tick [--collect-only|--advance-current|--start-next|--dispatch]" >&2; exit 64 ;;
  esac
done

paid_mode=0
case "$mode" in dispatch|advance|frontier) paid_mode=1 ;; esac
dispatch_limit="$(rule max_concurrent_sessions)"
case "$dispatch_limit" in ''|null|*[!0-9]*|0) dispatch_limit=1 ;; esac
started_sessions=0
collected_count=0

acquire_lock || { echo "another tick holds the lock; exiting"; exit 0; }
trap release_lock EXIT

say() { printf '[%s] %s\n' "$(date +%T)" "$*"; }

paid_slot_available() {
  local active
  [ "$paid_mode" = 1 ] || return 1
  if circuit_breaker_active; then
    say "circuit-breaker active; model dispatch paused for cooldown"
    return 1
  fi
  active="$(tmux list-sessions -F '#S' 2>/dev/null |
    grep -Ec "^${tmux_session_prefix}-[0-9]+-(impl|rev)-" || true)"
  [ "$active" -lt "$dispatch_limit" ]
}

paid_spawn() { # session-id model variant workdir prompt-file
  paid_slot_available || return 75
  if workdir_has_live_owner "$4"; then
    timeline implement "session $1 | spawn blocked: workdir has a live writer"
    return 76
  fi
  if KOKOLOG_PAID_DISPATCH=1 "$LOOP_ROOT/run/spawn" start "$1" "$2" "$3" "$4" "$5" >/dev/null; then
    started_sessions=$((started_sessions + 1))
    metric implement runs.jsonl "\"event\":\"paid-session-start\",\"session\":\"$1\",\"model\":\"$2\",\"variant\":\"$3\",\"dispatch_limit\":$dispatch_limit"
    return 0
  fi
  return 1
}

# ---------- preflight (soft) ------------------------------------------------
have_bin() { command -v "$1" >/dev/null 2>&1; }
session_live() { tmux has-session -t "${tmux_session_prefix}-$1" 2>/dev/null; }
missing_bins=()
required_bins=(gh git jq shasum tmux)
[ "$paid_mode" = 0 ] || required_bins+=(opencode)
for required_bin in "${required_bins[@]}"; do
  have_bin "$required_bin" || missing_bins+=("$required_bin")
done
if [ "${#missing_bins[@]}" -gt 0 ]; then
  reason="missing binaries: ${missing_bins[*]}"
  say "$reason"
  timeline implement "tick | skipped: $reason (run run/doctor)"
  exit 69
fi
if [ "$paid_mode" = 1 ] && ! domain_active implement; then
  say "paid dispatch skipped: Build & Verify is paused"
  exit 0
fi
GH_REPO="$(ghrepo)" || { say "cannot resolve gh repo"; exit 0; }
LABEL="$(jqget .github.frontier_label)"
INTEG_LABEL="$(jqget .github.integration_label)"
BRANCH_PREFIX="$(jqget '.github.branch_prefix // empty')"
BASE_BRANCH="$(jqget '.github.base_branch // empty')"
CLIENT_REMOTE="$(git -C "$KOKOLOG_REPO" remote get-url origin 2>/dev/null || true)"
if ! branch_prefix_valid "$BRANCH_PREFIX" || [ -z "$BASE_BRANCH" ] || [ -z "$CLIENT_REMOTE" ]; then
  timeline implement "tick | skipped: invalid GitHub branch configuration or client remote (run run/doctor)"
  exit 0
fi
if ! git ls-remote --exit-code "$CLIENT_REMOTE" "refs/heads/$BASE_BRANCH" >/dev/null 2>&1; then
  timeline implement "tick | skipped: base branch $BASE_BRANCH unavailable (run run/doctor)"
  exit 0
fi

# ---------- reap stray clones ------------------------------------------------
if [ "$mode" = collect ]; then
  reap_days="$(rule clone_reap_days)"
  find "$CLONES" -maxdepth 1 -type d -name '[0-9]*' -mtime "+${reap_days:-7}" -exec rm -rf {} + 2>/dev/null || true
fi

# ---------- reap timed-out sessions -------------------------------------------
timeout_sec="$(rule session_timeout_sec)"
inactivity_timeout_sec="$(rule session_inactivity_timeout_sec)"
termination_grace_sec="$(rule session_termination_grace_sec)"
case "$inactivity_timeout_sec" in ''|null|*[!0-9]*) inactivity_timeout_sec=900 ;; esac
case "$termination_grace_sec" in ''|null|*[!0-9]*) termination_grace_sec=5 ;; esac
if [ "$mode" = collect ]; then
for sess in $(tmux list-sessions -F '#S' 2>/dev/null | grep "^${tmux_session_prefix}-" | sed "s/^${tmux_session_prefix}-//"); do
  [ -f "$SESSIONS/$sess.done" ] && continue
  started="$SESSIONS/$sess.spawn.json"
  [ -f "$started" ] || started="$SESSIONS/$sess.prompt"
  [ -f "$started" ] || continue
  age=$(( $(date +%s) - $(stat -f %m "$started") ))
  activity="$started"
  [ ! -s "$LOGS/$sess.jsonl" ] || activity="$LOGS/$sess.jsonl"
  idle=$(( $(date +%s) - $(stat -f %m "$activity") ))
  termination_reason=""
  if [ "$idle" -gt "$inactivity_timeout_sec" ]; then
    termination_reason="inactivity watchdog: no model or tool event for ${idle}s"
  elif [ "$age" -gt "${timeout_sec:-7200}" ]; then
    termination_reason="wall-clock timeout: ${age}s exceeded ${timeout_sec:-7200}s"
  fi
  if [ -n "$termination_reason" ]; then
    printf '%s\n' "$termination_reason" > "$SESSIONS/$sess.termination-reason.tmp" &&
      mv "$SESSIONS/$sess.termination-reason.tmp" "$SESSIONS/$sess.termination-reason"
    if ! terminate_session "$sess" "$termination_grace_sec"; then
      if [ ! -e "$SESSIONS/$sess.termination-failed" ]; then
        timeline implement "session $sess | CRITICAL: worker process group survived TERM and KILL"
      fi
      touch "$SESSIONS/$sess.termination-failed"
      continue
    fi
    rm -f "$SESSIONS/$sess.termination-failed"
    [ -s "$SESSIONS/$sess.result" ] || printf 'RUNTIME LIMIT: %s\n' "$termination_reason" > "$SESSIONS/$sess.result"
    if [ ! -f "$SESSIONS/$sess.done" ]; then
      printf '143\n' > "$SESSIONS/$sess.exit.tmp" && mv "$SESSIONS/$sess.exit.tmp" "$SESSIONS/$sess.exit"
      touch "$SESSIONS/$sess.done"
    fi
    case "$sess" in
      dist-*)  timeline spec-sync "session $sess | stopped: $termination_reason" ;;
      desk-*)  timeline decision-desk "session $sess | stopped: $termination_reason" ;;
      *)       timeline implement "session $sess | stopped: $termination_reason" ;;
    esac
  fi
done
fi

# ---------- recover sessions lost without their done sentinel ---------------
# A tmux session that vanishes (crash, reboot) leaves no .done: spawn-exec's
# traps never ran. Review and fix sessions re-spawn from desired state on
# their own; only frontier implementer sessions need recovery here.
record_lost_session() { # ticket session reason status
  local n="$1" sid="$2" reason="$3" status="$4" file limit
  file="$STATE/$n.runtime.json"
  limit="$(rule max_clean_retries)"
  case "$limit" in ''|null|*[!0-9]*) limit=1 ;; esac
  jq -n --argjson ticket "$n" --arg sid "$sid" --arg reason "$reason" --arg status "$status" \
    --arg at "$(date -u +%FT%TZ)" --argjson limit "$limit" \
    '{schema:1,ticket:$ticket,phase:"in-progress",role:"implementer",failed_session:$sid,root_session:$sid,
      exit_code:70,reason:$reason,status:$status,automatic_retry_limit:$limit,automatic_retries:0,
      retry_sequence:0,updated_at:$at}' > "$file.tmp" && mv "$file.tmp" "$file"
}
if [ "$mode" = collect ]; then
for pf in "$SESSIONS"/*.prompt; do
  [ -e "$pf" ] || continue
  id="${pf%.prompt}"; id="${id##*/}"
  case "$id" in *-impl-*) ;; *) continue ;; esac
  [ -f "$SESSIONS/$id.done" ] && continue
  session_live "$id" && continue
  n="${id%%-impl-*}"
  [ -f "$STATE/$n.in-progress" ] || continue
  mv "$pf" "$pf.lost.$(date +%s)"
  [ -e "$SESSIONS/$id.result" ] && mv "$SESSIONS/$id.result" "$SESSIONS/$id.result.lost.$(date +%s)"
  lost="$(ls "$SESSIONS/$n-impl"-a*.prompt.lost* 2>/dev/null | wc -l | tr -d ' ')"
  maxa="$(rule max_impl_attempts)"
  metric implement runs.jsonl "\"event\":\"session-lost\",\"ticket\":$n,\"session\":\"$id\",\"lost\":$lost"
  if [ "$lost" -le "${maxa:-3}" ]; then
    record_lost_session "$n" "$id" "implementer session disappeared without completion ($lost/$maxa)" retry-ready
    timeline implement "ticket $n | lost session queued for a clean retry ($lost/$maxa)"
  else
    record_lost_session "$n" "$id" "$lost implementer sessions disappeared; clean retry needs owner authorization" needs-retry
    timeline implement "ticket $n | operational retry limit reached after $lost lost sessions"
  fi
done
fi

# ---------- harvest finished sessions ----------------------------------------
# session ids: <ticket>-impl-aN | <ticket>-rev-<profile>-rN | loop-<domain>-*
review_state_file() { printf '%s/%s.review.json\n' "$STATE" "$1"; }

PR_CHECK_ROLLUP=""
pr_checks_ready() { # PR URL [head-sha]; 0 terminal, 1 pending/not registered, 2 unavailable
  local pr="$1" head="${2:-}" rollup count pending
  if ! rollup="$(github_pr_checks "$pr" "$GH_REPO" "$head")"; then
    return 2
  fi
  PR_CHECK_ROLLUP="$rollup"
  count="$(printf '%s' "$rollup" | jq '.statusCheckRollup | length')"
  [ "$count" -gt 0 ] || return 1
  pending="$(printf '%s' "$rollup" | jq '
    [.statusCheckRollup[] |
      if .__typename == "CheckRun" then
        (.status != "COMPLETED")
      else
        ((.state // "PENDING") == "PENDING" or (.state // "PENDING") == "EXPECTED")
      end] | any')"
  [ "$pending" = false ]
}

write_json() { # destination; JSON on stdin
  local destination="$1" tmp="$1.tmp.$$"
  if jq -S . > "$tmp"; then mv "$tmp" "$destination"; else rm -f "$tmp"; return 1; fi
}

runtime_state_file() { printf '%s/%s.runtime.json\n' "$STATE" "$1"; }

runtime_exit_reason() { # session-id role exit-code
  local sid="$1" role="$2" exit_code="$3" termination_reason
  termination_reason="$(cat "$SESSIONS/$sid.termination-reason" 2>/dev/null || true)"
  if [ -n "$termination_reason" ]; then
    printf '%s operational failure: %s\n' "$role" "$termination_reason"
  elif [ "$exit_code" = 70 ]; then
    printf '%s operational failure: worker wrote no result\n' "$role"
  else
    printf '%s operational runtime exit %s\n' "$role" "$exit_code"
  fi
}

record_runtime_failure() { # ticket session-id role exit-code [reason]
  local n="$1" sid="$2" role="$3" exit_code="$4" file old retries limit status reason phase root is_rate_limit=0
  if detect_api_rate_limit "$sid"; then
    is_rate_limit=1
    trip_circuit_breaker "$sid" "$role" "API rate limit or quota exceeded"
  fi
  file="$(runtime_state_file "$n")"
  old="$(cat "$file" 2>/dev/null || echo '{}')"
  retries="$(printf '%s' "$old" | jq -r '.automatic_retries // 0')"
  case "$retries" in ''|*[!0-9]*) retries=0 ;; esac
  limit="$(rule max_clean_retries)"
  case "$limit" in ''|null|*[!0-9]*) limit=1 ;; esac
  if [ "$is_rate_limit" = 1 ]; then
    status=retry-ready
    reason="${5:-$role operational failure: API rate limit / quota exceeded (cooldown active)}"
  else
    if [ "$retries" -lt "$limit" ]; then status=retry-ready; else status=needs-retry; fi
    reason="${5:-$(runtime_exit_reason "$sid" "$role" "$exit_code")}"
  fi
  phase=in-progress
  [ -e "$STATE/$n.review" ] && phase=review
  [ -e "$STATE/$n.fix" ] && phase=fix
  root="${sid%-retry[0-9]*}"
  printf '%s' "$old" | jq --argjson ticket "$n" --arg phase "$phase" --arg role "$role" \
    --arg sid "$sid" --arg root "$root" --argjson exit "$exit_code" --arg reason "$reason" \
    --arg status "$status" --arg at "$(date -u +%FT%TZ)" --argjson limit "$limit" '
      .schema=1 | .ticket=$ticket | .phase=$phase | .role=$role |
      .failed_session=$sid | .root_session=$root | .exit_code=$exit |
      .reason=$reason | .status=$status | .automatic_retry_limit=$limit |
      .updated_at=$at | .retry_sequence=(.retry_sequence // 0) |
      .automatic_retries=(.automatic_retries // 0)' | write_json "$file"
  timeline implement "ticket $n | $reason; clean retry status: $status"
}

prepare_clean_clone() { # ticket session-id prior-session-id
  local n="$1" sid="$2" prior_sid="$3" target pr meta prn head_ref head_oid old_workdir branch
  target="$CLONES/$n-${sid#"$n-"}"
  case "$target" in "$CLONES/$n-"*) ;; *) return 1 ;; esac
  [ ! -e "$target" ] || rm -rf "$target"
  git clone -q "$CLIENT_REMOTE" "$target" || return 1
  pr="$(github_known_pr "$n")"
  if [ -n "$pr" ]; then
    meta="$(github_pr_view "$pr" "$GH_REPO" "number,state,headRefName,headRefOid")" || return 1
    [ "$(printf '%s' "$meta" | jq -r .state)" = OPEN ] || return 1
    prn="$(printf '%s' "$meta" | jq -r .number)"
    head_ref="$(printf '%s' "$meta" | jq -r .headRefName)"
    head_oid="$(printf '%s' "$meta" | jq -r .headRefOid)"
    git -C "$target" fetch -q origin "+refs/pull/$prn/head:refs/remotes/origin/kokolog-pr-$prn" || return 1
    git -C "$target" checkout -q -b "$head_ref" "refs/remotes/origin/kokolog-pr-$prn" || return 1
    [ "$(git -C "$target" rev-parse HEAD)" = "$head_oid" ] || return 1
  else
    old_workdir="$(jq -r '.workdir // empty' "$SESSIONS/$prior_sid.spawn.json" 2>/dev/null || true)"
    branch="$(git -C "$old_workdir" branch --show-current 2>/dev/null || true)"
    [ -n "$branch" ] || branch="${BRANCH_PREFIX}-${n}/$(branch_slug "retry")"
    if git ls-remote --exit-code "$CLIENT_REMOTE" "refs/heads/$branch" >/dev/null 2>&1; then
      git -C "$target" fetch -q origin "refs/heads/$branch:refs/remotes/origin/$branch" || return 1
      git -C "$target" checkout -q -b "$branch" "refs/remotes/origin/$branch" || return 1
    else
      git -C "$target" checkout -q -b "$branch" "origin/$BASE_BRANCH" || return 1
    fi
  fi
  printf '%s\n' "$target"
}

write_implement_prompt() { # ticket session clone title [verdict]
  local n="$1" sid="$2" clone="$3" title="$4" verdict="${5:-}" output issue_json issue_body
  output="$(worker_result_path "$clone" "$sid")"
  issue_json="$(github_issue_view "$n" "$GH_REPO" "url,title,body" 2>/dev/null || true)"
  issue_body="$(printf '%s' "$issue_json" | jq -r '.body // empty' 2>/dev/null || true)"
  {
    cat "$LOOP_ROOT/agents/implementer.md"
    printf '\n# Controller task\n\n'
    printf 'Issue #%s (%s) in %s.\n' "$n" "$title" "$GH_REPO"
    printf 'This checkout starts from authoritative GitHub state. Do not inspect any path outside this checkout.\n'
    printf 'Required PR base: %s. The PR must include `Closes #%s`.\n' "$BASE_BRANCH" "$n"
    printf 'If this PR branch has merge conflicts or is behind `origin/%s`, merge `origin/%s` and resolve all conflicts cleanly.\n\n' "$BASE_BRANCH" "$BASE_BRANCH"
    if [ -n "$issue_body" ]; then
      printf '## Issue specification\n\n%s\n\n' "$issue_body"
    fi
    if [ -n "$verdict" ]; then
      printf 'Repair only these current P0/P1 blockers. Do not implement advisories:\n\n'
      sed -n '/^blockers:$/,/^advisories:$/p' "$verdict" | sed '$d'
    fi
    printf '\nWrite the final result atomically to %s. Do not write controller state or read prior session logs.\n' "$output"
  } > "$SESSIONS/$sid.prompt"
}

dispatch_runtime_retries() {
  local file status n old_sid role seq retry_sid clone title rs action started=1
  for file in "$STATE"/*.runtime.json; do
    [ -e "$file" ] || break
    status="$(jq -r '.status // empty' "$file")"
    [ "$status" = retry-ready ] || continue
    n="$(jq -r .ticket "$file")"; old_sid="$(jq -r .failed_session "$file")"; role="$(jq -r .role "$file")"
    ticket_session_live "$n" && continue
    paid_slot_available || return 75
    seq=$(( $(jq -r '.retry_sequence // 0' "$file") + 1 ))
    retry_sid="$(jq -r .root_session "$file")-retry$seq"
    while [ -e "$SESSIONS/$retry_sid.prompt" ] || [ -e "$SESSIONS/$retry_sid.done" ]; do
      seq=$((seq + 1))
      retry_sid="$(jq -r .root_session "$file")-retry$seq"
    done
    jq --argjson seq "$seq" '.retry_sequence=$seq' "$file" | write_json "$file"
    clone="$(prepare_clean_clone "$n" "$retry_sid" "$old_sid")" || { timeline implement "ticket $n | clean retry clone failed"; continue; }
    rs="$(review_state_file "$n")"
    if [ "$role" = reviewer ] && [ -s "$rs" ]; then
      jq --arg sid "$retry_sid" '.action="review" | .session_id=$sid' "$rs" | write_json "$rs" || continue
      spawn_profile_review "$rs" "$clone" || continue
    elif [ -s "$rs" ] && [ "$(jq -r '.action // empty' "$rs")" = fix ]; then
      jq --arg sid "$retry_sid" '.session_id=$sid' "$rs" | write_json "$rs" || continue
      spawn_fix "$rs" "$clone" || continue
    else
      title="$(github_issue_view "$n" "$GH_REPO" title | jq -r .title 2>/dev/null || echo "Tracked work")"
      write_implement_prompt "$n" "$retry_sid" "$clone" "$title"
      paid_spawn "$retry_sid" "$(route_model implementer)" "$(route_variant implementer)" "$clone" "$SESSIONS/$retry_sid.prompt" || continue
    fi
    jq --arg sid "$retry_sid" --arg at "$(date -u +%FT%TZ)" --argjson seq "$seq" '
      .status="running" | .retry_session=$sid | .retry_sequence=$seq |
      .automatic_retries=(.automatic_retries + (if .owner_authorized == true then 0 else 1 end)) |
      .owner_authorized=false | .updated_at=$at' "$file" | write_json "$file"
    timeline implement "ticket $n | clean retry started as $retry_sid"
    started=0
  done
  return "$started"
}

park_review() { # desired-state file source-session reason
  local rs="$1" sid="$2" reason="$3" n
  n="$(jq -r .ticket "$rs")"
  jq --arg sid "$sid" '.action="parked" | .last_applied_session=$sid' "$rs" | write_json "$rs" || return 1
  st_set "$n" parked "$reason"
  timeline implement "ticket $n | parked: $reason"
}

review_contract_failure() { # desired-state file source-session reason
  local rs="$1" sid="$2" reason="$3" n
  n="$(jq -r .ticket "$rs")"
  record_runtime_failure "$n" "$sid" reviewer 70 "$reason"
  jq --arg reason "$reason" '.contract_failure=$reason' "$rs" | write_json "$rs" || return 1
  timeline implement "ticket $n | reviewer contract failure: $reason"
}

mark_merged_unverified() { # desired-state file source-session
  local rs="$1" sid="$2" n completed required reason
  n="$(jq -r .ticket "$rs")"
  completed="$(jq -r '.completed | length' "$rs")"
  required="$((completed + $(jq -r '.remaining | length' "$rs")))"
  reason="PR merged before assurance completed ($completed/$required reviews passed)"
  jq --arg sid "$sid" '.action="merged-unverified" | .last_applied_session=$sid' "$rs" | write_json "$rs" || return 1
  st_set "$n" merged-unverified
  printf '%s\n' "$reason" > "$STATE/$n.merged-unverified"
  metric implement runs.jsonl "\"event\":\"merged-unverified\",\"ticket\":$n,\"completed\":$completed,\"required\":$required"
  timeline implement "ticket $n | merged-unverified: $reason"
}

mark_merged_verified() { # desired-state file
  local rs="$1" n round head merged_at
  n="$(jq -r .ticket "$rs")"
  round="$(jq -r .round "$rs")"
  head="$(jq -r .head_oid "$rs")"
  merged_at="$(date -u +%FT%TZ)"
  jq --arg at "$merged_at" '.action="merged" | .merged_at=$at' "$rs" | write_json "$rs" || return 1
  st_set "$n" merged
  metric implement runs.jsonl "\"event\":\"merged\",\"ticket\":$n,\"round\":$round,\"head\":\"${head:0:12}\""
  timeline implement "ticket $n | merged after unified assurance PASS at ${head:0:12}"
}

start_review_cycle() { # ticket PR source-session
  local n="$1" pr="$2" source="$3" rs assurance round=1 blocking_repairs=0 clone patch_file reason
  rs="$(review_state_file "$n")"; assurance="$STATE/$n.assurance.json"
  [ -f "$rs" ] && [ "$(jq -r '.source_session // ""' "$rs")" = "$source" ] && return 0
  if [ -f "$rs" ]; then
    round=$(( $(jq -r '.round // 0' "$rs") + 1 ))
    blocking_repairs="$(jq -r '.blocking_repairs // 0' "$rs")"
  fi
  clone="$(prepare_clean_clone "$n" "$n-assurance-r$round" "$source")" || {
    timeline implement "ticket $n | review preparation deferred: clean PR clone failed"; return 1;
  }
  if ! "$LOOP_ROOT/run/assurance-classify" "$n" "$pr" "$clone" "$assurance" >/dev/null; then
    reason="assurance classification failed"; st_set "$n" parked "$reason"; timeline implement "ticket $n | parked: $reason"; return 1
  fi
  if ! jq -e '.policy_version == "assurance-v2" and .required_verdicts == ["assurance"] and
      (.dimensions | index("acceptance")) != null and (.dimensions | index("code")) != null' "$assurance" >/dev/null; then
    reason="invalid assurance classification"; st_set "$n" parked "$reason"; timeline implement "ticket $n | parked: $reason"; return 1
  fi
  cp "$assurance" "$STATE/$n.assurance-r$round.json"
  patch_file="$STATE/$n.assurance-r$round.patch"
  if ! git -C "$clone" diff --no-ext-diff "$(jq -r .base_oid "$assurance")...$(jq -r .head_oid "$assurance")" > "$patch_file.tmp"; then
    rm -f "$patch_file.tmp"
    reason="immutable review patch could not be created"; st_set "$n" parked "$reason"; timeline implement "ticket $n | parked: $reason"; return 1
  fi
  mv "$patch_file.tmp" "$patch_file"
  rm -f "$STATE/$n.verified"
  jq -n --argjson ticket "$n" --argjson round "$round" --argjson blocking_repairs "$blocking_repairs" --arg source "$source" \
    --arg pr "$(jq -r .pr "$assurance")" --arg base "$(jq -r .base_oid "$assurance")" \
    --arg head "$(jq -r .head_oid "$assurance")" --argjson remaining "$(jq -c .required_verdicts "$assurance")" \
    '{ticket:$ticket,pr:$pr,base_oid:$base,head_oid:$head,round:$round,blocking_repairs:$blocking_repairs,
      source_session:$source,remaining:$remaining,completed:[],action:"review",
      profile:$remaining[0],session_id:("\($ticket)-rev-\($remaining[0])-r\($round)"),
      last_applied_session:null}' | write_json "$rs" || return 1
  st_set "$n" review
  metric implement runs.jsonl "\"event\":\"assurance-classified\",\"ticket\":$n,\"round\":$round,\"head\":\"$(jq -r '.head_oid[0:12]' "$assurance")\""
  timeline implement "ticket $n | revision $round classified for unified assurance at $(jq -r '.head_oid[0:12]' "$assurance")"
}

harvest_impl() { # ticket session-id
  local n="$1" sid="$2" res="$SESSIONS/$2.result" pr rs clone branch checkout_head pr_meta pr_head pr_base closes reviewed_head reason
  rs="$(review_state_file "$n")"
  [ -f "$rs" ] && [ "$(jq -r '.source_session // ""' "$rs")" = "$sid" ] && return 0
  if grep -q 'DECOMPOSE' "$res" 2>/dev/null; then
    reason="needs decomposition"; st_set "$n" parked "$reason"; timeline implement "ticket $n | parked: $reason"; return
  fi
  clone="$(jq -r '.workdir // empty' "$SESSIONS/$sid.spawn.json" 2>/dev/null || true)"
  branch="$(git -C "$clone" branch --show-current 2>/dev/null || true)"
  pr="$(github_known_pr "$n")"
  if [ -z "$pr" ] && [ -n "$branch" ]; then
    pr="$(github_open_pr_for_branch "$GH_REPO" "$branch")"
  fi
  if [ -z "$pr" ]; then
    record_runtime_failure "$n" "$sid" implementer 70
    timeline implement "ticket $n | implementation contract incomplete: no open PR for branch ${branch:-unknown}"
    return 0
  fi
  checkout_head="$(git -C "$clone" rev-parse HEAD 2>/dev/null || true)"
  pr_meta="$(github_pr_view "$pr" "$GH_REPO" "headRefOid,baseRefName,closingIssuesReferences" 2>/dev/null || true)"
  pr_head="$(printf '%s' "$pr_meta" | jq -r '.headRefOid // empty')"
  pr_base="$(printf '%s' "$pr_meta" | jq -r '.baseRefName // empty')"
  closes="$(printf '%s' "$pr_meta" | jq --argjson n "$n" '[.closingIssuesReferences[]?.number | select(. == $n)] | length')"
  [ -n "$checkout_head" ] && [ "$checkout_head" = "$pr_head" ] || {
    record_runtime_failure "$n" "$sid" implementer 70
    timeline implement "ticket $n | implementation contract incomplete: checkout does not match PR head"; return 0
  }
  [ "$pr_base" = "$BASE_BRANCH" ] || {
    record_runtime_failure "$n" "$sid" implementer 70
    timeline implement "ticket $n | implementation contract incomplete: PR base $pr_base is not $BASE_BRANCH"; return 0
  }
  [ "$closes" = 1 ] || {
    record_runtime_failure "$n" "$sid" implementer 70
    timeline implement "ticket $n | implementation contract incomplete: PR must close issue #$n"; return 0
  }
  reviewed_head="$(jq -r '.head_oid // empty' "$rs" 2>/dev/null || true)"
  if [ -n "$reviewed_head" ] && [ "$pr_head" = "$reviewed_head" ]; then
    record_runtime_failure "$n" "$sid" implementer 70
    timeline implement "ticket $n | repair contract incomplete: PR head did not change"
    return 0
  fi
  rm -f "$(runtime_state_file "$n")"
  printf '%s\n' "$pr" > "$STATE/$n.pr"
  start_review_cycle "$n" "$pr" "$sid"
}

spawn_profile_review() { # desired-state file
  local rs="$1" n pr round profile head base sid clone role_file role_name route_role pf check_state
  local patch_file evidence_dir evidence_file patch_sha issue_snapshot
  n="$(jq -r .ticket "$rs")"; pr="$(jq -r .pr "$rs")"; round="$(jq -r .round "$rs")"
  profile="$(jq -r .profile "$rs")"; head="$(jq -r .head_oid "$rs")"; base="$(jq -r .base_oid "$rs")"
  sid="$(jq -r .session_id "$rs")"; clone="${2:-}"
  case "$profile" in
    assurance) role_file="$LOOP_ROOT/agents/reviewer.md"; role_name="Unified Assurance Reviewer"; route_role="reviewer" ;;
    *) park_review "$rs" "$sid" "unknown assurance profile $profile"; return 1 ;;
  esac
  ticket_session_live "$n" && return 0
  [ -f "$SESSIONS/$sid.done" ] && return 0
  session_live "$sid" && return 0
  if [ -z "$clone" ]; then
    clone="$(prepare_clean_clone "$n" "$sid" "$(jq -r '.source_session // empty' "$rs")")" || {
      say "ticket #$n review deferred: clean PR clone failed"; return 1;
    }
  fi
  check_state=0
  pr_checks_ready "$pr" || check_state=$?
  case "$check_state" in
    0) ;;
    1) say "ticket #$n review deferred: PR checks are pending"; return 0 ;;
    2) say "ticket #$n review deferred: PR checks are unavailable"; return 0 ;;
    *) say "ticket #$n review deferred: invalid PR check state"; return 1 ;;
  esac
  patch_file="$STATE/$n.assurance-r$round.patch"
  [ -s "$patch_file" ] || { park_review "$rs" "$sid" "immutable review patch is missing"; return 1; }
  if ! issue_snapshot="$(github_issue_view "$n" "$GH_REPO" "url,title,body,labels")"; then
    say "ticket #$n review deferred: issue evidence is unavailable"
    return 0
  fi
  evidence_dir="$STATE/review-evidence"
  evidence_file="$evidence_dir/$sid.json"
  mkdir -p "$evidence_dir"
  patch_sha="$(shasum -a 256 "$patch_file" | awk '{print $1}')"
  jq -n --argjson schema 1 --argjson ticket "$n" --arg profile "$profile" --argjson cycle "$round" \
    --arg base_oid "$base" --arg head_oid "$head" --arg patch "$patch_file" --arg patch_sha256 "$patch_sha" \
    --argjson issue "$issue_snapshot" --argjson checks "$PR_CHECK_ROLLUP" \
    '{schema:$schema,ticket:$ticket,profile:$profile,revision_cycle:$cycle,base_oid:$base_oid,head_oid:$head_oid,
      patch:$patch,patch_sha256:$patch_sha256,issue:$issue,checks:$checks.statusCheckRollup}' | write_json "$evidence_file" || {
        park_review "$rs" "$sid" "review evidence snapshot could not be created"; return 1
      }
  local private_evidence private_patch private_assurance private_impl private_verdict private_result
  private_evidence="$clone/.git/kokolog-loop/evidence"
  mkdir -p "$private_evidence"
  private_patch="$private_evidence/patch.diff"
  private_assurance="$private_evidence/assurance.json"
  private_impl="$private_evidence/implementation-result.md"
  cp "$patch_file" "$private_patch"
  cp "$STATE/$n.assurance-r$round.json" "$private_assurance"
  cp "$evidence_file" "$private_evidence/review-evidence.json"
  cp "$(ls -t "$SESSIONS/$n-impl"-a*.result 2>/dev/null | head -1)" "$private_impl" 2>/dev/null || printf 'No implementation result was retained.\n' > "$private_impl"
  private_verdict="$(worker_verdict_path "$clone" "$sid")"
  private_result="$(worker_result_path "$clone" "$sid")"
  rm -f "$VERDICTS/$n-verdict.md" "$SESSIONS/$sid.result" "$SESSIONS/$sid.exit"
  pf="$SESSIONS/$sid.prompt"
  {
    cat "$role_file"
    printf '\n# Controller task\n\nYou are the %s.\n' "$role_name"
    printf 'Review all dimensions selected in the assurance artifact. Issue: %s. Revision: %s.\n' "$n" "$round"
    printf 'PR: %s\nBASE_OID: %s\nHEAD_OID: %s\n' "$pr" "$base" "$head"
    printf 'Read immutable patch %s and assurance artifact %s.\n' "$private_patch" "$private_assurance"
    printf 'Read issue and terminal CI evidence from %s.\n' "$private_evidence/review-evidence.json"
    printf 'Implementation evidence: %s\n' "$private_impl"
    printf 'Do not use shell commands to inspect or change the checkout. Use read and search tools on the immutable artifacts and checkout.\n'
    printf 'For the two required outputs only, use the runtime-permitted printf-to-.tmp and mv operations described in the reviewer protocol.\n'
    printf 'Write %s atomically. Include PROFILE, ROUND, PR, BASE_OID, and HEAD_OID exactly once.\n' "$private_verdict"
    printf 'Also write %s with exactly one line: VERDICT: PASS | BLOCK. The verdict file is authoritative.\n' "$private_result"
  } > "$pf"
  if paid_spawn "$sid" "$(route_model "$route_role")" "$(route_variant "$route_role")" "$clone" "$pf"; then
    timeline implement "ticket $n | unified assurance review for revision $round spawned"; return 0
  fi
  timeline implement "ticket $n | unified assurance review spawn deferred (revision $round)"; return 1
}

set_fix_desired() { # state file source-session archived-verdict
  local rs="$1" sid="$2" archived_verdict="$3" n round profile attempt blocking_repairs maxf fix_sid pr_state
  n="$(jq -r .ticket "$rs")"; round="$(jq -r .round "$rs")"; profile="$(jq -r .profile "$rs")"
  pr_state="$(github_pr_view "$(jq -r .pr "$rs")" "$GH_REPO" state | jq -r '.state // empty' 2>/dev/null || true)"
  if [ "$pr_state" != OPEN ]; then
    if [ "$pr_state" = MERGED ]; then
      mark_merged_unverified "$rs" "$sid"
    else
      park_review "$rs" "$sid" "cannot fix assurance finding on PR state ${pr_state:-unknown}"
    fi
    return
  fi
  maxf="$(rule max_fix_attempts)"
  blocking_repairs="$(jq -r '.blocking_repairs // 0' "$rs")"
  if [ "$blocking_repairs" -ge "${maxf:-3}" ]; then
    park_review "$rs" "$sid" "P0/P1 repair cycles exhausted ($maxf)"; return
  fi
  blocking_repairs=$((blocking_repairs + 1))
  attempt=$(( $(ls "$SESSIONS/$n-impl"-a*.prompt 2>/dev/null | wc -l | tr -d ' ') + 1 ))
  fix_sid="$n-impl-a$attempt"
  jq --arg sid "$sid" --arg fix_sid "$fix_sid" --argjson attempt "$attempt" --argjson blocking_repairs "$blocking_repairs" \
    --arg verdict "$archived_verdict" \
    '.action="fix" | .session_id=$fix_sid | .attempt=$attempt | .fix_attempt=$blocking_repairs |
     .blocking_repairs=$blocking_repairs | .verdict_file=$verdict |
     .last_applied_session=$sid' "$rs" | write_json "$rs"
  st_set "$n" fix
}

spawn_fix() { # desired-state file [prepared clean clone]
  local rs="$1" n sid attempt blocking_repairs profile verdict clone pf model variant reason
  n="$(jq -r .ticket "$rs")"; sid="$(jq -r .session_id "$rs")"; attempt="$(jq -r '.attempt // 1' "$rs")"
  blocking_repairs="$(jq -r '.blocking_repairs // .fix_attempt // 0' "$rs")"
  profile="$(jq -r .profile "$rs")"; verdict="$(jq -r .verdict_file "$rs")"
  ticket_session_live "$n" && return 0
  session_live "$sid" && return 0
  while [ -f "$SESSIONS/$sid.done" ]; do
    attempt=$((attempt + 1))
    sid="$n-impl-a$attempt"
    jq --arg sid "$sid" --argjson attempt "$attempt" '.session_id=$sid | .attempt=$attempt' "$rs" | write_json "$rs"
  done
  [ -f "$SESSIONS/$sid.done" ] && return 0
  clone="${2:-}"
  if [ -z "$clone" ]; then
    clone="$(prepare_clean_clone "$n" "$sid" "$(jq -r '.last_applied_session // empty' "$rs")")" || {
      timeline implement "ticket $n | repair deferred: clean PR clone failed"; return 1;
    }
  fi
  model="$(route_model repairer)"; variant="$(route_variant repairer)"
  rm -f "$SESSIONS/$sid.result" "$SESSIONS/$sid.exit"
  pf="$SESSIONS/$sid.prompt"
  write_implement_prompt "$n" "$sid" "$clone" "P0/P1 repair cycle $blocking_repairs" "$verdict"
  if paid_spawn "$sid" "$model" "$variant" "$clone" "$pf"; then
    timeline implement "ticket $n | P0/P1 BLOCK -> repair $blocking_repairs spawned"; return 0
  fi
  timeline implement "ticket $n | repair $blocking_repairs spawn deferred"; return 1
}

harvest_review() { # ticket session-id
  local n="$1" sid="$2" rs profile round pr base head v archived verdict task bench_pending blocker_count advisory_count
  local blocker_lines advisory_lines field count reason
  rs="$(review_state_file "$n")"
  [ -f "$rs" ] || { record_runtime_failure "$n" "$sid" reviewer 70 "missing review state"; timeline implement "ticket $n | reviewer contract failure: missing review state"; return; }
  [ "$(jq -r '.last_applied_session // ""' "$rs")" = "$sid" ] && return 0
  [ "$(jq -r .session_id "$rs")" = "$sid" ] || { review_contract_failure "$rs" "$sid" "unexpected review session $sid"; return; }
  profile="$(jq -r .profile "$rs")"; round="$(jq -r .round "$rs")"; pr="$(jq -r .pr "$rs")"
  base="$(jq -r .base_oid "$rs")"; head="$(jq -r .head_oid "$rs")"
  archived="$VERDICTS/$n-$profile-r$round-${head:0:12}-verdict.md"; v="$VERDICTS/$n-verdict.md"
  if [ ! -f "$archived" ]; then
    [ -f "$v" ] || { review_contract_failure "$rs" "$sid" "no verdict file"; return; }
    for field in VERDICT TASK PROFILE ROUND PR BASE_OID HEAD_OID expected observed evidence blockers advisories; do
      count="$(grep -c "^${field}:" "$v" 2>/dev/null || true)"
      [ "$count" = 1 ] || { review_contract_failure "$rs" "$sid" "invalid $profile verdict field $field"; return; }
    done
    verdict="$(grep '^VERDICT:' "$v" | cut -d' ' -f2 | tr -d '"\\')"
    task="$(grep '^TASK:' "$v" | cut -d' ' -f2 | tr -d '"\\')"
    case "$verdict:$task" in
      PASS:works|BLOCK:broken|BLOCK:unproven) ;;
      *) review_contract_failure "$rs" "$sid" "invalid assurance verdict and task combination"; return ;;
    esac
    if grep -q '^BENCH:' "$v"; then
      count="$(grep -c '^BENCH:' "$v")"
      [ "$count" = 1 ] || { review_contract_failure "$rs" "$sid" "invalid BENCH field count"; return; }
      grep -qE '^BENCH: (pending|none)$' "$v" || { review_contract_failure "$rs" "$sid" "invalid BENCH value"; return; }
    fi
    [ "$(grep '^PROFILE:' "$v" | cut -d' ' -f2-)" = "$profile" ] &&
    [ "$(grep '^ROUND:' "$v" | cut -d' ' -f2-)" = "$round" ] &&
    [ "$(grep '^PR:' "$v" | cut -d' ' -f2-)" = "$pr" ] &&
    [ "$(grep '^BASE_OID:' "$v" | cut -d' ' -f2-)" = "$base" ] &&
    [ "$(grep '^HEAD_OID:' "$v" | cut -d' ' -f2-)" = "$head" ] || {
      review_contract_failure "$rs" "$sid" "verdict identity mismatch"; return
    }
    blocker_lines="$(sed -n '/^blockers:$/,/^advisories:$/p' "$v" | sed '1d;$d')"
    advisory_lines="$(sed -n '/^advisories:$/,$p' "$v" | sed '1d')"
    [ -n "$blocker_lines" ] && ! printf '%s\n' "$blocker_lines" | grep -Eqv '^(- none|- P[01] · .+)$' || {
      review_contract_failure "$rs" "$sid" "invalid blocker severity; only P0 and P1 may block"; return
    }
    [ -n "$advisory_lines" ] && ! printf '%s\n' "$advisory_lines" | grep -Eqv '^(- none|- P[23] · .+)$' || {
      review_contract_failure "$rs" "$sid" "invalid advisory severity; only P2 and P3 are advisory"; return
    }
    if [ "$verdict" = PASS ]; then
      [ "$blocker_lines" = "- none" ] || { review_contract_failure "$rs" "$sid" "PASS verdict contains blockers"; return; }
    else
      printf '%s\n' "$blocker_lines" | grep -Eq '^- P[01] · .+' &&
        ! printf '%s\n' "$blocker_lines" | grep -q '^- none$' || {
          review_contract_failure "$rs" "$sid" "BLOCK verdict must contain one or more P0/P1 blockers"; return
        }
    fi
    if printf '%s\n' "$advisory_lines" | grep -q '^- none$'; then
      [ "$advisory_lines" = "- none" ] || { review_contract_failure "$rs" "$sid" "advisories mix none with findings"; return; }
    fi
    mv "$v" "$archived"
  fi
  verdict="$(grep '^VERDICT:' "$archived" | cut -d' ' -f2 | tr -d '"\\')"; task="$(grep '^TASK:' "$archived" | cut -d' ' -f2 | tr -d '"\\')"
  bench_pending=0; grep -q '^BENCH: pending$' "$archived" && bench_pending=1
  blocker_count="$(sed -n '/^blockers:$/,/^advisories:$/p' "$archived" | grep -cE '^- P[01] · ' || true)"
  advisory_count="$(sed -n '/^advisories:$/,$p' "$archived" | grep -cE '^- P[23] · ' || true)"
  metric implement runs.jsonl "\"event\":\"verdict\",\"ticket\":$n,\"profile\":\"$profile\",\"verdict\":\"${verdict:-?}\",\"task\":\"${task:-?}\",\"round\":$round,\"bench\":\"$bench_pending\",\"blockers\":$blocker_count,\"advisories\":$advisory_count"
  if [ "$verdict" = PASS ] && [ "$task" = works ]; then
    jq --arg sid "$sid" --arg profile "$profile" --argjson bp "$bench_pending" '
      .bench=(if $bp == 1 then "pending" elif .bench == null then "" else .bench end) |
      .remaining=.remaining[1:] | .completed += [$profile] | .last_applied_session=$sid |
      if (.remaining|length)>0 then .action="review" | .profile=.remaining[0] |
        .session_id=("\(.ticket)-rev-\(.profile)-r\(.round)")
      else .action="done" | .session_id="" end' "$rs" | write_json "$rs"
  else
    set_fix_desired "$rs" "$sid" "$archived"
  fi
}

reconcile_assurance() {
  local rs action n pr stored_base stored_head live_revision live_state live_base live_head round note
  for rs in "$STATE"/*.review.json; do
    [ -e "$rs" ] || continue
    action="$(jq -r .action "$rs")"; n="$(jq -r .ticket "$rs")"
    case "$action" in
      review|done|complete)
        pr="$(jq -r .pr "$rs")"; stored_base="$(jq -r .base_oid "$rs")"; stored_head="$(jq -r .head_oid "$rs")"
        if ! live_revision="$(github_pr_view "$pr" "$GH_REPO" "state,baseRefOid,headRefOid")"; then
          say "assurance deferred: cannot read PR revision for #$n"; continue
        fi
        live_state="$(printf '%s' "$live_revision" | jq -r .state)"
        live_base="$(printf '%s' "$live_revision" | jq -r .baseRefOid)"
        live_head="$(printf '%s' "$live_revision" | jq -r .headRefOid)"
        if [ "$live_state" = MERGED ]; then
          if [ "$action" = review ] || [ "$live_base" != "$stored_base" ] || [ "$live_head" != "$stored_head" ]; then
            mark_merged_unverified "$rs" "$(jq -r '.session_id // ""' "$rs")"
          else
            mark_merged_verified "$rs"
          fi
          continue
        fi
        if [ "$action" = review ] && [ "$live_state" != OPEN ]; then
          park_review "$rs" "$(jq -r '.session_id // ""' "$rs")" "cannot continue assurance on PR state $live_state"
          continue
        fi
        if [ "$live_base" != "$stored_base" ] || [ "$live_head" != "$stored_head" ]; then
          start_review_cycle "$n" "$pr" "revision-change:$live_base:$live_head"; continue
        fi
        case "$action" in
          review) spawn_profile_review "$rs" ;;
          done)
            round="$(jq -r .round "$rs")"
            st_set "$n" done
            if [ "$(jq -r '.bench // ""' "$rs")" = pending ]; then
              note="PR awaits owner merge and bench validation"
            else
              note="PR awaits owner merge"
            fi
            if [ ! -e "$STATE/$n.verified" ]; then
              timeline implement "ticket $n | unified assurance PASS on revision $round — $note"
              log_append "ticket $n verified" implement "Unified assurance passed for $stored_head; $note." "$STATE/$n.assurance-r$round.json"
              touch "$STATE/$n.verified"
            fi
            jq '.action="complete"' "$rs" | write_json "$rs"
            ;;
          complete) ;;
        esac
        ;;
      fix) spawn_fix "$rs" ;;
      parked|runtime-failed|merged|merged-unverified|merged-audited|manual-takeover) ;;
      *) park_review "$rs" "$(jq -r '.session_id // ""' "$rs")" "invalid assurance action $action" ;;
    esac
  done
}

if [ "$mode" = collect ]; then
for donef in "$SESSIONS"/*.done; do
  [ -e "$donef" ] || continue
  local_id="${donef%.done}"; local_id="${local_id##*/}"
  harvested="${donef%.done}.harvested"
  [ -e "$harvested" ] && continue
  run_exit="$(cat "$SESSIONS/$local_id.exit" 2>/dev/null || echo 1)"
  harvest_ok=1
  if [ "$run_exit" != 0 ]; then
    case "$local_id" in
      *-impl-*) n="${local_id%%-impl-*}"; record_runtime_failure "$n" "$local_id" implementer "$run_exit" ;;
      *-rev-*)  n="${local_id%%-rev-*}";  record_runtime_failure "$n" "$local_id" reviewer "$run_exit" ;;
      dist-*)   timeline spec-sync "session $local_id | failed: runtime exit $run_exit" ;;
      desk-*)   timeline decision-desk "session $local_id | failed: runtime exit $run_exit" ;;
    esac
  else
    case "$local_id" in
      *-impl-*) n="${local_id%%-impl-*}"; rm -f "$(runtime_state_file "$n")"; harvest_impl "$n" "$local_id" || harvest_ok=0 ;;
      *-rev-*)  n="${local_id%%-rev-*}";  rm -f "$(runtime_state_file "$n")"; harvest_review "$n" "$local_id" || harvest_ok=0 ;;
      dist-*)   timeline spec-sync "distiller session finished: $local_id" ;;
      desk-*)   timeline decision-desk "decision-batch session finished: $local_id" ;;
    esac
  fi
  # Mark only after a successful transition. A crash or failed state write
  # leaves the source replayable on the next tick.
  if [ "$harvest_ok" = 1 ]; then
    touch "$harvested"
    collected_count=$((collected_count + 1))
  fi
done
fi

# ---------- frontier (implement domain) --------------------------------------
frontier() {
  domain_active implement || { say "implement paused"; return 0; }
  paid_slot_available || { say "all concurrency slots in use; frontier idle this tick"; return 0; }
  local issues
  issues="$(gh issue list -R "$GH_REPO" --label "$LABEL" --state open --search 'sort:created-asc' --limit 100 \
            --json number,title,createdAt --jq '.[] | "\(.number)\t\(.title)"' 2>/dev/null)" || {
    issues="$(gh api "repos/$GH_REPO/issues?labels=$(printf '%s' "$LABEL" | jq -sRr @uri)&state=open&per_page=100" --jq '.[] | "\(.number)\t\(.title)"' 2>/dev/null || true)"
  }
  [ -n "$issues" ] || { say "frontier empty"; return 0; }
  while IFS=$'\t' read -r n title; do
    st_exists "$n" && continue
    # Native GitHub relationships are the primary dependency graph. Inline
    # "Blocked by" references remain a conservative compatibility check.
    local metadata native_blockers is_parent is_integration open_subissues body
    local slug branch remote_issue_branches existing_branch existing_pr reason
    metadata="$(github_issue_view "$n" "$GH_REPO" "body,blockedBy,subIssues,labels")" || {
      say "frontier unavailable: cannot read dependencies for #$n"
      return 1
    }
    # A parent issue is a container, not work. It never enters the frontier
    # unless it is a deliberate integration task marked with the integration
    # label, and then only after all its subissues close.
    is_parent="$(printf '%s' "$metadata" | jq '(.subIssues.totalCount // 0) > 0')"
    case "$is_parent" in true|false) ;; *) say "frontier unavailable: invalid subissue data for #$n"; return 1 ;; esac
    if [ "$is_parent" = true ]; then
      is_integration="$(printf '%s' "$metadata" | jq --arg l "$INTEG_LABEL" '([.labels[]?.name] | index($l)) != null')"
      case "$is_integration" in true|false) ;; *) say "frontier unavailable: invalid label data for #$n"; return 1 ;; esac
      if [ "$is_integration" != true ]; then
        metric implement runs.jsonl "\"event\":\"frontier-skip\",\"ticket\":$n,\"reason\":\"parent-not-integration\""
        say "#$n is a parent container without the integration label; ignoring"
        continue
      fi
    fi
    native_blockers="$(printf '%s' "$metadata" | jq '[.blockedBy.nodes[]? | select(.state != "CLOSED" and .state != "MERGED")] | length')"
    case "$native_blockers" in ''|*[!0-9]*) say "frontier unavailable: invalid native dependencies for #$n"; return 1 ;; esac
    if [ "$native_blockers" -gt 0 ]; then
      metric implement runs.jsonl "\"event\":\"frontier-skip\",\"ticket\":$n,\"reason\":\"native-blockers\",\"count\":$native_blockers"
      say "#$n blocked by $native_blockers open native dependency(s)"
      continue
    fi
    open_subissues="$(printf '%s' "$metadata" | jq '[.subIssues.nodes[]? | select(.state != "CLOSED")] | length')"
    case "$open_subissues" in ''|*[!0-9]*) say "frontier unavailable: invalid native subissues for #$n"; return 1 ;; esac
    if [ "$open_subissues" -gt 0 ]; then
      metric implement runs.jsonl "\"event\":\"frontier-skip\",\"ticket\":$n,\"reason\":\"open-subissues\",\"count\":$open_subissues"
      say "#$n deferred until $open_subissues native subissue(s) close"
      continue
    fi
    body="$(printf '%s' "$metadata" | jq -r '.body // ""')"
    blocked=0
    for b in $(printf '%s' "$body" | sed -n '/[Bb]locked by/,/^[A-Z*#]/p' | grep -o '#[0-9]\+' | tr -d '#'); do
      s="$(github_issue_view "$b" "$GH_REPO" state | jq -r '.state // "open"' 2>/dev/null || echo open)"
      case "$s" in CLOSED|MERGED) ;; *) blocked=1; break ;; esac
    done
    if [ "$blocked" = 1 ]; then
      metric implement runs.jsonl "\"event\":\"frontier-skip\",\"ticket\":$n,\"reason\":\"inline-blocker\""
      say "#$n blocked by an open inline dependency"
      continue
    fi
    slug="$(branch_slug "$title")"
    branch="${BRANCH_PREFIX}-${n}/${slug}"
    if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then
      reason="generated branch name is invalid"
      st_set "$n" parked "$reason"
      timeline implement "ticket $n | parked: $reason"
      park_auto_card "branch-invalid-$n" implement \
        "Ticket $n produced an invalid branch name — rename the issue or change the branch prefix?" \
        "The generated branch was $branch. The loop did not clone or modify the client repository." \
        "- ticket: https://github.com/$(ghrepo)/issues/$n
- branch: $branch"
      continue
    fi
    if ! remote_issue_branches="$(git ls-remote --heads "$CLIENT_REMOTE" "refs/heads/${BRANCH_PREFIX}-${n}/*" 2>/dev/null)"; then
      timeline implement "ticket $n | frontier branch lookup failed; retry next tick"
      continue
    fi
    existing_branch="$(printf '%s\n' "$remote_issue_branches" | awk 'NR==1 {sub(/^.*refs\/heads\//, ""); print}')"
    if [ -n "$existing_branch" ]; then
      existing_pr="$(github_open_pr_for_branch "$GH_REPO" "$existing_branch")"
      [ -z "$existing_pr" ] || printf '%s\n' "$existing_pr" > "$STATE/$n.pr"
      reason="branch $existing_branch already exists"
      st_set "$n" parked "$reason"
      metric implement runs.jsonl "\"event\":\"frontier-park\",\"ticket\":$n,\"reason\":\"branch-exists\""
      timeline implement "ticket $n | parked: $reason"
      park_auto_card "branch-exists-$n" implement \
        "Ticket $n already has a remote branch — review its PR or recover the branch?" \
        "Stable branch naming found $existing_branch. The loop will not create a duplicate branch." \
        "- ticket: https://github.com/$(ghrepo)/issues/$n
- branch: $existing_branch
- open PR: ${existing_pr:-none found}"
      continue
    fi
    # spawn implementer in a fresh clone
    clone="$CLONES/$n-a1"
    if ! git clone -q --branch "$BASE_BRANCH" --single-branch "$CLIENT_REMOTE" "$clone" 2>/dev/null; then
      rm -rf "$clone"
      timeline implement "ticket $n | frontier clone from $BASE_BRANCH failed; retry next tick"
      continue
    fi
    if ! git -C "$clone" remote set-url origin "$CLIENT_REMOTE"; then
      rm -rf "$clone"
      timeline implement "ticket $n | frontier clone remote failed; retry next tick"
      continue
    fi
    if ! git -C "$clone" checkout -q -b "$branch" "origin/$BASE_BRANCH"; then
      rm -rf "$clone"
      timeline implement "ticket $n | branch from origin/$BASE_BRANCH failed; retry next tick"
      continue
    fi
    pf="$SESSIONS/$n-impl-a1.prompt"
    write_implement_prompt "$n" "$n-impl-a1" "$clone" "$title"
    if paid_spawn "$n-impl-a1" "$(route_model implementer)" \
      "$(route_variant implementer)" "$clone" "$pf"; then
      st_set "$n" in-progress
      timeline implement "ticket $n | implementer spawned (frontier)"
      say "spawned implementer for #$n: $title"
    else
      rm -rf "$clone"
      timeline implement "ticket $n | frontier spawn failed; retry next tick"
    fi
    paid_slot_available || return 0
  done <<<"$issues"
}
tracked_paid_work_exists() {
  local state_file
  for state_file in "$STATE"/*.in-progress "$STATE"/*.review "$STATE"/*.fix; do
    [ -e "$state_file" ] && return 0
  done
  return 1
}

case "$mode" in
  collect)
    if [ "$collected_count" -gt 0 ]; then
      metric implement runs.jsonl "\"event\":\"collect\",\"results\":$collected_count,\"model_sessions_started\":0"
      timeline implement "collect | $collected_count completed result(s) updated; no model sessions started"
    fi
    say "collection complete: $collected_count result(s); no model sessions started"
    ;;
  advance)
    dispatch_runtime_retries || true
    [ "$started_sessions" -ge "$dispatch_limit" ] || reconcile_assurance
    metric implement runs.jsonl "\"event\":\"dispatch\",\"scope\":\"current\",\"started\":$started_sessions,\"limit\":$dispatch_limit"
    timeline implement "dispatch | current work: $started_sessions/$dispatch_limit model sessions started"
    say "current-work dispatch complete: $started_sessions/$dispatch_limit model sessions started"
    ;;
  frontier)
    if tracked_paid_work_exists; then
      say "new issue deferred: tracked paid work is pending"
    elif ! frontier; then
      metric implement runs.jsonl '"event":"dispatch","scope":"frontier","outcome":"blocked","reason":"github-frontier-unavailable"'
      timeline implement "dispatch | new issue blocked: GitHub frontier unavailable"
      exit 1
    fi
    metric implement runs.jsonl "\"event\":\"dispatch\",\"scope\":\"frontier\",\"started\":$started_sessions,\"limit\":$dispatch_limit"
    timeline implement "dispatch | new issue: $started_sessions/$dispatch_limit model sessions started"
    say "new-issue dispatch complete: $started_sessions/$dispatch_limit model sessions started"
    ;;
  dispatch)
    dispatch_runtime_retries || true
    [ "$started_sessions" -ge "$dispatch_limit" ] || reconcile_assurance
    if [ "$started_sessions" -lt "$dispatch_limit" ] && ! tracked_paid_work_exists; then
      if ! frontier; then
        metric implement runs.jsonl '"event":"dispatch","scope":"scheduled","outcome":"blocked","reason":"github-frontier-unavailable"'
        timeline implement "dispatch | scheduled work blocked: GitHub frontier unavailable"
        exit 1
      fi
    fi
    metric implement runs.jsonl "\"event\":\"dispatch\",\"scope\":\"scheduled\",\"started\":$started_sessions,\"limit\":$dispatch_limit"
    timeline implement "dispatch | scheduled work: $started_sessions/$dispatch_limit model sessions started"
    say "scheduled dispatch complete: $started_sessions/$dispatch_limit model sessions started"
    ;;
esac
