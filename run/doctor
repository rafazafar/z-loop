#!/bin/bash
# doctor — preflight. Read-only checks; tells you exactly what to fix.
set -uo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

fail=0; warn=0
ok()   { printf '  ok    %s\n' "$1"; }
bad()  { printf '  FAIL  %s\n' "$1"; fail=$((fail+1)); }
soft() { printf '  warn  %s\n' "$1"; warn=$((warn+1)); }

echo "== binaries =="
for b in opencode gh git jq tmux; do
  command -v "$b" >/dev/null 2>&1 && ok "$b ($(command -v $b))" || bad "$b missing from PATH"
done

echo "== client repo =="
[ -d "$KOKOLOG_REPO/.git" ] && ok "repo: $KOKOLOG_REPO" || bad "not a git repo: $KOKOLOG_REPO (set KOKOLOG_REPO in config.env)"
gh auth status >/dev/null 2>&1 && ok "gh authenticated" || bad "gh not authenticated: run gh auth login"
GH_REPO="$(ghrepo 2>/dev/null)" && ok "github: $GH_REPO" || bad "cannot resolve GitHub repo (is origin set?)"

echo "== github labels =="
if [ -n "${GH_REPO:-}" ]; then
  frontier_label="$(jqget .github.frontier_label)"
  labels="$(gh label list -R "$GH_REPO" --search "$frontier_label" --json name 2>/dev/null || true)"
  if jq -e --arg name "$frontier_label" 'any(.[]; .name == $name)' <<< "$labels" >/dev/null 2>&1; then
    ok "label $(jqget .github.frontier_label) exists"
  else
    soft "label $(jqget .github.frontier_label) missing -> gh label create $(jqget .github.frontier_label) -R $GH_REPO"
  fi
  integ_label="$(jqget .github.integration_label)"
  if [ -n "$integ_label" ] && [ "$integ_label" != "null" ]; then
    labels="$(gh label list -R "$GH_REPO" --search "$integ_label" --json name 2>/dev/null || true)"
    if jq -e --arg name "$integ_label" 'any(.[]; .name == $name)' <<< "$labels" >/dev/null 2>&1; then
      ok "label $integ_label exists"
    else
      soft "label $integ_label missing -> gh label create $integ_label -R $GH_REPO"
    fi
  fi
fi

echo "== routing =="
jq empty "$ROUTING" 2>/dev/null && ok "routing.json parses" || bad "routing.json invalid JSON"
for role in implementer reviewer ticketer distiller gardener decision-desk; do
  m="$(route_model "$role")"
  v="$(route_variant "$role")"
  [ -n "$m" ] && [ -n "$v" ] && ok "$role -> $m ($v)" || bad "$role has no resolvable model and variant"
done
echo "       (models resolve via your GLOBAL opencode providers: 9router, openai, zai coding plan)"

echo "== local setup =="
ok "all local configuration: $ROUTING"
tmux list-sessions >/dev/null 2>&1 && ok "tmux server up" || ok "tmux server will start on first spawn"
[ -d "$KOKOLOG_REPO/docs/meeting-transcripts" ] && ok "transcripts dir found" || soft "no docs/meeting-transcripts in repo (spec-sync idle)"

echo
[ "$fail" = 0 ] && echo "RESULT: ready (warns: $warn)" || echo "RESULT: $fail hard failure(s). Fix the FAIL lines above."
exit "$fail"
