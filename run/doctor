#!/bin/bash
# doctor — preflight. Read-only checks; tells you exactly what to fix.
set -uo pipefail
LOOP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck disable=SC1090
. "$LOOP_ROOT/run/common.sh"

require_model_runtime=1
case "${1:-}" in
  "") ;;
  --no-model-runtime) require_model_runtime=0 ;;
  *) echo "usage: doctor [--no-model-runtime]" >&2; exit 64 ;;
esac

fail=0; warn=0
ok()   { printf '  ok    %s\n' "$1"; }
bad()  { printf '  FAIL  %s\n' "$1"; fail=$((fail+1)); }
soft() { printf '  warn  %s\n' "$1"; warn=$((warn+1)); }

echo "== binaries =="
required_bins=(gh git jq shasum tmux)
[ "$require_model_runtime" = 0 ] || required_bins=(opencode "${required_bins[@]}")
for b in "${required_bins[@]}"; do
  command -v "$b" >/dev/null 2>&1 && ok "$b ($(command -v $b))" || bad "$b missing from PATH"
done

echo "== client repo =="
[ -d "$PROJECT_REPO/.git" ] && ok "repo: $PROJECT_REPO" || bad "not a git repo: $PROJECT_REPO (set repo_path in config.json)"
gh auth status >/dev/null 2>&1 && ok "gh authenticated" || bad "gh not authenticated: run gh auth login"
GH_REPO="$(ghrepo 2>/dev/null)" && ok "github: $GH_REPO" || bad "cannot resolve GitHub repo (is origin set?)"

echo "== github base =="
base_branch="$(jqget '.github.base_branch // empty')"
branch_prefix="$(jqget '.github.branch_prefix // empty')"
client_remote="$(git -C "$PROJECT_REPO" remote get-url origin 2>/dev/null || true)"
if [ -z "$base_branch" ]; then
  bad "github.base_branch is missing"
elif [ -z "$client_remote" ]; then
  bad "client origin remote is missing"
elif git ls-remote --exit-code "$client_remote" "refs/heads/$base_branch" >/dev/null 2>&1; then
  ok "base branch origin/$base_branch exists"
else
  bad "base branch origin/$base_branch does not exist"
fi
if branch_prefix_valid "$branch_prefix"; then
  ok "issue branches: ${branch_prefix}-<number>/<title-slug>"
else
  bad "github.branch_prefix must contain lowercase words, digits, or single hyphens"
fi
if [ -n "${GH_REPO:-}" ] && [ -n "$base_branch" ]; then
  default_branch="$(gh repo view "$GH_REPO" --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null || true)"
  [ -n "$default_branch" ] || default_branch="$(gh api "repos/$GH_REPO" --jq '.default_branch' 2>/dev/null || true)"
  [ "$default_branch" = "$base_branch" ] && ok "PR base matches repository default ($base_branch)" || \
    soft "configured PR base $base_branch differs from repository default ${default_branch:-unknown}"
fi

github_label_exists() {
  local repo="$1" label="$2" labels
  if labels="$(gh label list -R "$repo" --search "$label" --json name 2>/dev/null)"; then
    jq -e --arg name "$label" 'any(.[]; .name == $name)' <<< "$labels" >/dev/null 2>&1 && return 0
  fi
  gh api "repos/$repo/labels/$(printf '%s' "$label" | jq -sRr @uri)" >/dev/null 2>&1
}

echo "== github labels =="
if [ -n "${GH_REPO:-}" ]; then
  frontier_label="$(jqget .github.frontier_label)"
  if github_label_exists "$GH_REPO" "$frontier_label"; then
    ok "label $frontier_label exists"
  else
    soft "label $frontier_label missing -> gh label create $frontier_label -R $GH_REPO"
  fi
  integ_label="$(jqget .github.integration_label)"
  if [ -n "$integ_label" ] && [ "$integ_label" != "null" ]; then
    if github_label_exists "$GH_REPO" "$integ_label"; then
      ok "label $integ_label exists"
    else
      soft "label $integ_label missing -> gh label create $integ_label -R $GH_REPO"
    fi
  fi
  decision_label="$(jqget '.github.decision_label // empty')"
  if [ -n "$decision_label" ] && github_label_exists "$GH_REPO" "$decision_label"; then
    ok "label $decision_label exists"
  else
    bad "github.decision_label is missing or unavailable"
  fi
fi

echo "== configuration =="
cfg_basename="$(basename "$CONFIG")"
jq empty "$CONFIG" 2>/dev/null && ok "$cfg_basename parses" || bad "$cfg_basename invalid JSON"
for role in implementer repairer reviewer ticketer distiller gardener decision-desk; do
  m="$(route_model "$role")"
  v="$(route_variant "$role")"
  [ -n "$m" ] && [ -n "$v" ] && ok "$role -> $m ($v)" || bad "$role has no resolvable model and variant"
done
test_cmd="$(cfg_cmd test)"
lint_cmd="$(cfg_cmd lint)"
[ -n "$test_cmd" ] && ok "test command: $test_cmd" || soft "no commands.test configured"
[ -n "$lint_cmd" ] && ok "lint command: $lint_cmd" || soft "no commands.lint configured"

fix_attempts="$(rule max_fix_attempts)"
case "$fix_attempts" in
  ''|null|*[!0-9]*|0) bad "rules.max_fix_attempts must be a positive integer" ;;
  *) ok "P0/P1 repairs per ticket: $fix_attempts" ;;
esac
clean_retries="$(rule max_clean_retries)"
case "$clean_retries" in
  ''|null|*[!0-9]*) bad "rules.max_clean_retries must be a non-negative integer" ;;
  *) ok "automatic clean retries: $clean_retries" ;;
esac
dispatch_limit="$(rule max_concurrent_sessions)"
case "$dispatch_limit" in
  ''|null|*[!0-9]*|0) bad "rules.max_concurrent_sessions must be a positive integer" ;;
  *) ok "maximum concurrent paid sessions: $dispatch_limit" ;;
esac
echo "       (models resolve via your GLOBAL opencode providers: 9router, openai, zai coding plan)"

echo "== local setup =="
ok "all local configuration: $CONFIG"
tmux list-sessions >/dev/null 2>&1 && ok "tmux server up" || ok "tmux server will start on first spawn"
spec_sync_enabled="$(jq -r '.domains.spec_sync.enabled // true' "$CONFIG" 2>/dev/null)"
if [ "$spec_sync_enabled" = "true" ]; then
  rel_transcripts="$(jq -r '.domains.spec_sync.transcripts_path // "docs/meeting-transcripts"' "$CONFIG" 2>/dev/null)"
  [ -d "$PROJECT_REPO/$rel_transcripts" ] && ok "transcripts dir found: $rel_transcripts" || soft "no $rel_transcripts in repo (spec-sync idle)"
else
  ok "spec-sync domain disabled (skipping transcript directory check)"
fi

echo
[ "$fail" = 0 ] && echo "RESULT: ready (warns: $warn)" || echo "RESULT: $fail hard failure(s). Fix the FAIL lines above."
exit "$fail"
